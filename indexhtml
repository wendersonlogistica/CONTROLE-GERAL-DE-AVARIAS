<!-- ============================================================
     V207 TESTE - PADRAO DE LINHAS COMPACTAS EM TODOS OS CARDS
     Base: V206 aprovada nos pontos funcionais.
     Objetivo:
     - Todas as linhas dos cards operacionais seguem o padrao compacto da imagem.
     - Sem quebra de linha em nenhuma coluna.
     - Descricao, fornecedor, motivo, endereco e observacao em uma linha com reticencias.
     - Quantidades centralizadas.
     - Valores alinhados a direita.
     - Manter cabecalho real visivel, sem oscilacao, LOTE menor e ACOES ajustado.
     - Nao alterar Demerito, Valores Diarios, calculos, periodo, orcamento ou base.
     ============================================================ -->
<script>
(function(){
  if(window.__v207LinhasCompactasInstalado) return;
  window.__v207LinhasCompactasInstalado = true;

  var DEM = 'DEMÉRITO';
  var VAL = 'VALORES DIÁRIOS';
  var oldToggleV207 = window.toggleDestino;
  var oldRenderV207 = window.render;

  function $(id){return document.getElementById(id);}
  function qsa(sel){return Array.prototype.slice.call(document.querySelectorAll(sel));}
  function isEspecial(card){return card===DEM || card===VAL;}
  function activeCard(){try{return selecionados&&selecionados.size?Array.from(selecionados)[0]:'LOTE DE AVARIA';}catch(e){return 'LOTE DE AVARIA';}}
  function setActive(card){try{selecionados=new Set([card]);}catch(e){window.selecionados=new Set([card]);}}

  function aplicarPadraoLinhasV207(card){
    card = card || activeCard();
    var tbl = $('mainTable');
    if(!tbl) return;
    tbl.classList.add('mainTableV207');
    tbl.setAttribute('data-card', card);
    tbl.setAttribute('data-card-v207', card);

    var sheet = document.querySelector('.sheet');
    if(sheet) sheet.classList.add('sheetV207');

    // Classe em todas as celulas dos cards normais.
    qsa('#mainTable tbody td, #mainTable thead th').forEach(function(c){
      c.classList.add('celulaCompactaV207');
    });

    // Colunas de descricao conforme cada tipo de card.
    var descIndex = (card === 'LOTE DE AVARIA') ? 2 : 3;
    qsa('#mainTable tbody tr td:nth-child('+descIndex+')').forEach(function(td){
      td.classList.add('descricaoCompactaV207');
      var txt = (td.textContent || '').replace(/\s+/g,' ').trim();
      if(txt) td.setAttribute('title', txt);
    });

    // Fornecedor, motivo, endereco e observacao recebem o mesmo comportamento de uma linha.
    qsa('#mainTable tbody td').forEach(function(td){
      if(!td.classList.contains('colAcoesV206') && !td.classList.contains('colAcoesV207')){
        var txt = (td.textContent || '').replace(/\s+/g,' ').trim();
        if(txt && txt.length > 12) td.setAttribute('title', txt);
      }
    });

    // Valores e quantidades.
    qsa('#mainTable tbody td.num').forEach(function(td){td.classList.add('valorCompactoV207');});
    qsa('#mainTable tbody td.center').forEach(function(td){td.classList.add('centroCompactoV207');});
    qsa('#mainTable tbody tr td:last-child, #mainTable thead tr th:last-child').forEach(function(c){c.classList.add('colAcoesV207');});
    qsa('#mainTable tbody tr td:last-child button').forEach(function(b){b.classList.add('btnAcaoV207');});
  }

  // Mantem a logica da V206, apenas aplica o padrao visual apos renderizar card normal.
  window.toggleDestino = function(card){
    var r;
    if(isEspecial(card)){
      if(typeof oldToggleV207 === 'function') r = oldToggleV207.apply(this, arguments);
      return r;
    }
    if(typeof oldToggleV207 === 'function') r = oldToggleV207.apply(this, arguments);
    else setActive(card || 'LOTE DE AVARIA');
    aplicarPadraoLinhasV207(card || activeCard());
    return r;
  };
  try{toggleDestino = window.toggleDestino;}catch(e){}

  window.render = function(){
    var card = activeCard();
    var r;
    if(typeof oldRenderV207 === 'function') r = oldRenderV207.apply(this, arguments);
    if(!isEspecial(card)) aplicarPadraoLinhasV207(card);
    return r;
  };
  try{render = window.render;}catch(e){}

  document.addEventListener('DOMContentLoaded', function(){
    setTimeout(function(){aplicarPadraoLinhasV207(activeCard());}, 800);
  });
})();
</script>

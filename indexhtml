  }

  function aplicarDescricaoSemQuebraV206(card){
    var selector = '';
    if(card==='LOTE DE AVARIA') selector = '#mainTable[data-card="LOTE DE AVARIA"] tbody tr td:nth-child(2)';
    else selector = '#mainTable[data-card="'+card+'"] tbody tr td:nth-child(3)';
    qsa(selector).forEach(function(td){
      td.classList.add('descricaoSemQuebraV206');
      var txt=(td.textContent||'').replace(/\s+/g,' ').trim();
      if(txt) td.setAttribute('title',txt);
    });
  }

  function aplicarVisualV206(card){
    qsa('#tabs .tab, .tabs .tab').forEach(function(tab,idx){
      var txt=(tab.textContent||'').toUpperCase();
      if(txt.indexOf('LOTE DE AVARIA')>=0 || tab.classList.contains('tabLoteV186') || idx===0){
        tab.classList.add('tabLoteMenorV206');

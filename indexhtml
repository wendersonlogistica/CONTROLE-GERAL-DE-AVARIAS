    });
    qsa('#mainTable thead tr th:last-child,#mainTable tbody tr td:last-child').forEach(function(c){c.classList.add('colAcoesV206');});
    qsa('#mainTable tbody tr td:last-child button').forEach(function(b){b.classList.add('btnAcaoV206');});
    aplicarDescricaoSemQuebraV206(card||activeCard());
    forcarCabecalhoRealV206(card||activeCard());
  }

  function renderCardNormalV206(card){
    card = card || 'LOTE DE AVARIA';
    setActive(card);
    document.body.classList.remove('modoDemeritoV121','modoValoresDiariosV122');

    var tbl=$('mainTable'), thead=$('thead'), tbody=$('tbody'), title=$('tableTitle');
    if(title) title.textContent = card;
    if(tbl){
      tbl.classList.add('mainTableV206');
      tbl.setAttribute('data-card',card);
      tbl.setAttribute('data-card-v206',card);
    }

    // IMPORTANTE V206:
    // Nao chama headers(card), pois em algumas versoes headers(card) apenas retorna array
    // e rotinas antigas voltam a esconder o thead. A V206 monta o cabecalho real diretamente.
    var hs = headV206(card);
    if(thead){
      thead.innerHTML = '<tr data-card-v206="'+esc(card)+'">' + hs.map(function(h){ return '<th>'+esc(h)+'</th>'; }).join('') + '</tr>';
    }

    var arr=[];
    try{ if(typeof filtrados==='function') arr=filtrados(card)||[]; }catch(e){ arr=[]; }
    if(tbody){

      '<td class="num" title="'+escV210(moedaV210(custo))+'">'+escV210(moedaV210(custo))+'</td>' +
      '<td class="center" title="'+escV210(qtd)+'">'+escV210(qtd)+'</td>' +
      '<td class="num" title="'+escV210(moedaV210(total))+'">'+escV210(moedaV210(total))+'</td>' +
      '<td title="'+escV210(x.palete)+'">'+escV210(x.palete)+'</td>' +
      '<td title="'+escV210(x.endereco)+'">'+escV210(x.endereco)+'</td>' +
      '<td title="'+escV210(x.observacao)+'">'+escV210(x.observacao)+'</td>' +
      acoes +
    '</tr>';
  }

  window.row = function(x, forExport){
    var dest = normalV210(x && x.destino);
    if(dest === 'DEB.MOTORISTA' || dest === 'DEB MOTORISTA'){
      return rowDebMotoristaV210(x, forExport);
    }
    if(rowOriginalV210) return rowOriginalV210.apply(this, arguments);
    return '';
  };
  try{ row = window.row; }catch(e){}

  function aplicarV210(){

        td.style.textOverflow='ellipsis';
        var txt=(td.textContent||'').replace(/\s+/g,' ').trim();
        if(txt) td.setAttribute('title',txt);
      });
      tbl.querySelectorAll('tbody td:last-child button').forEach(function(b){
        b.classList.add('btnAcaoV206');
      });
    }
  }

  // Depois que o painel renderizar DEB.MOTORISTA, reaplica somente o visual do card.
  var oldToggleV210 = window.toggleDestino;
  if(typeof oldToggleV210 === 'function'){
    window.toggleDestino = function(card){
      var r = oldToggleV210.apply(this, arguments);
      if(normalV210(card).indexOf('DEB') >= 0 || normalV210(card).indexOf('MOTORISTA') >= 0){
        setTimeout(function(){
          try{
            var tbody=document.getElementById('tbody');
            var title=document.getElementById('tableTitle');
            var ativo=normalV210(title ? title.textContent : '');
            if(tbody && (ativo.indexOf('DEB')>=0 || ativo.indexOf('MOTORISTA')>=0)){
              // Se alguma rotina antiga limpou o corpo, remonta apenas DEB.MOTORISTA.
              if(!tbody.querySelector('tr[data-card-row-v210="DEB.MOTORISTA"]')){
                var arr=[];
                try{ if(typeof filtrados==='function') arr=filtrados('DEB.MOTORISTA') || []; }catch(e){ arr=[]; }
                if(arr.length){ tbody.innerHTML = arr.map(function(x){ return rowDebMotoristaV210(x,false); }).join(''); }
              }
            }
          }catch(e){}
          aplicarV210();
        }, 60);
      }
      return r;
    };
    try{ toggleDestino = window.toggleDestino; }catch(e){}
  }

  document.addEventListener('DOMContentLoaded', function(){
    setTimeout(aplicarV210, 800);

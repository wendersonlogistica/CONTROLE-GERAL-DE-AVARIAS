<script>
/* ============================================================
   V186 TESTE - VERSAO LIMPA UNIFICADA
   Base limpa: V175 aprovada.
   Inclui em um unico bloco:
   - Periodo de Movimento compacto com aplicacao automatica.
   - Todos os cards recalculados pelo periodo aplicado.
   - Demerito e Valores Diarios estabilizados pelo mesmo periodo.
   - Card LOTE DE AVARIA com Real e Sug.
   - Cabecalho e linhas renderizados juntos, sem disputa entre LOTE e VENCIDOS.
   - VENCIDOS com DESCRICAO sem quebra de linha, igual LOTE.
   - Sem setInterval e sem acumulacao de camadas V180-V185.
   ============================================================ */
(function(){
  var DEM='DEMÉRITO';
  var VAL='VALORES DIÁRIOS';
  var KEY_INI='periodoMovIniV186';
  var KEY_FIM='periodoMovFimV186';
  var rendering=false;

  function $(id){return document.getElementById(id);}
  function pad(n){return String(n).padStart(2,'0');}
  function allCards(){
    try{return (typeof destinos!=='undefined'&&Array.isArray(destinos))?destinos:['LOTE DE AVARIA','RECUPERADO','BAIXA POR PERDA','VENCIDOS','DEV.FORNC','TROCA CLIENTE','DEB.MOTORISTA'];}
    catch(e){return ['LOTE DE AVARIA','RECUPERADO','BAIXA POR PERDA','VENCIDOS','DEV.FORNC','TROCA CLIENTE','DEB.MOTORISTA'];}
  }
  function base(){try{return (typeof lancamentos!=='undefined'&&Array.isArray(lancamentos))?lancamentos:[];}catch(e){return [];}}
  function active(){try{return (typeof selecionados!=='undefined'&&selecionados&&selecionados.size)?Array.from(selecionados)[0]:'';}catch(e){return '';}}
  function setActive(card){try{selecionados=new Set([card]);}catch(e){window.selecionados=new Set([card]);}}
  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c;});}
  function attr(s){return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'");}
  function iso(v){
    if(v===null||v===undefined||v==='')return '';
    var s=String(v).trim();
    try{if(typeof normDate==='function'){var n=normDate(s);if(/^\d{4}-\d{2}-\d{2}/.test(n))return n.slice(0,10);}}catch(e){}
    if(/^\d{4}-\d{2}-\d{2}/.test(s))return s.slice(0,10);
    var m=s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
    if(m)return m[3]+'-'+pad(m[2])+'-'+pad(m[1]);
    var d=new Date(s);
    if(!isNaN(d))return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
    return '';
  }
  function fmtBR(s){s=iso(s);if(!s)return '';var p=s.split('-');return p[2]+'/'+p[1]+'/'+p[0];}
  function periodo(){
    var p={ini:'',fim:''};
    try{p.ini=localStorage.getItem(KEY_INI)||'';p.fim=localStorage.getItem(KEY_FIM)||'';}catch(e){}
    window.periodoMovimentoV186=p;
    return p;
  }
  function savePeriodo(ini,fim){
    try{localStorage.setItem(KEY_INI,ini||'');localStorage.setItem(KEY_FIM,fim||'');}catch(e){}
    window.periodoMovimentoV186={ini:ini||'',fim:fim||''};
  }
  function periodoTexto(){
    var p=periodo();
    if(p.ini&&p.fim)return fmtBR(p.ini)+' a '+fmtBR(p.fim);
    if(p.ini)return 'a partir de '+fmtBR(p.ini);
    if(p.fim)return 'até '+fmtBR(p.fim);
    return 'Todos';
  }
  function inPeriodo(x){
    var p=periodo(),d=iso(x&&x.data);
    if(!d)return true;
    if(p.ini&&d<p.ini)return false;
    if(p.fim&&d>p.fim)return false;
    return true;
  }
  function sortByDate(arr){
    return (arr||[]).slice().sort(function(a,b){
      var da=iso(a&&a.data),db=iso(b&&b.data);
      if(da!==db)return da.localeCompare(db);
      return String((a&&a.codigo)||'').localeCompare(String((b&&b.codigo)||''),'pt-BR',{numeric:true});
    });
  }
  function filtered(card){return sortByDate(base().filter(function(x){return x.destino===card&&inPeriodo(x);}));}
  function head(card){
    var d=String(card||'').toUpperCase();
    if(d==='BAIXA POR PERDA')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','FORNECEDOR','MOTIVO DA PERDA','CUSTO REAL UNIT','QTDE.','VLR TOTAL','OBSERVAÇÃO','AÇÕES'];
    if(d==='RECUPERADO')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','FORNECEDOR','CUSTO REAL UNIT','QTD RECUP','VLR RECUPERADO','PALETE','ENDEREÇO','OBSERVAÇÃO','AÇÕES'];
    if(d==='VENCIDOS')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','VALIDADE','FORNECEDOR','CUSTO REAL UNIT','QTDE.','VLR TOTAL','PALETE','ENDEREÇO','OBSERVAÇÃO','AÇÕES'];
    if(d==='DEV.FORNC')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','MOT. DEVOLUÇÃO','FORNECEDOR','CUSTO REAL UNIT','QTDE.','VLR TOTAL','PALETE','ENDEREÇO','OBSERVAÇÃO','AÇÕES'];
    if(d==='TROCA CLIENTE')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','MOT. TROCA','FORNECEDOR','CUSTO REAL UNIT','QTDE.','VLR TOTAL','PALETE','ENDEREÇO','OBSERVAÇÃO','AÇÕES'];
    if(d==='DEB.MOTORISTA')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','FORNECEDOR','CUSTO REAL UNIT','QTDE.','VLR TOTAL','PALETE','ENDEREÇO','OBSERVAÇÃO','AÇÕES'];
    return ['CÓDIGO','DESCRIÇÃO','FORNECEDOR','VLR VENDA UNT','QTDE.','VLR TOTAL','PALETE','ESTADO DA AVARIA','DESCONTO (%) SUGERIDO','PREÇO UNIT C/ DESCONTO','SUGESTÃO PREÇO DE VENDA','DATA','ENDEREÇO','MOT.AVARIA','OBSERVAÇÃO','AÇÕES'];
  }
  function paintHeader(card){
    var h=head(card), th=$('thead'), mt=$('mainTable');
    if(th)th.innerHTML='<tr data-card-v186="'+esc(card)+'">'+h.map(function(c){return '<th>'+esc(c)+'</th>';}).join('')+'</tr>';
    if(mt){mt.setAttribute('data-card',card);mt.setAttribute('data-card-v186',String(card).toUpperCase());}
    return h;
  }
  function realLote(arr){return (arr||[]).reduce(function(t,x){return t+Number(x.valorTotal||0);},0);}
  function sugLote(arr){return (arr||[]).reduce(function(t,x){return t+(typeof sugestaoVendaLote==='function'?Number(sugestaoVendaLote(x)||0):Number(x.vlrLoteAvaria||0));},0);}
  function totalCard(card,arr){
    arr=arr||filtered(card);
    if(card==='LOTE DE AVARIA')return sugLote(arr);
    return arr.reduce(function(t,x){
      if(card==='RECUPERADO')return t+Number(x.vlrRecuperado||0);
      if(card==='BAIXA POR PERDA')return t+Number(x.vlrLixo||0);
      if(card==='VENCIDOS'||card==='DEV.FORNC'||card==='TROCA CLIENTE')return t+(Number(x.custo||0)*Number(x.qtdTotal||0));
      return t+Number(x.valorTotal||0);
    },0);
  }
  function qtdCard(card,arr){
    arr=arr||filtered(card);
    return arr.reduce(function(q,x){
      if(card==='LOTE DE AVARIA')return q+Number(x.qtdLoteVenda||0);
      if(card==='RECUPERADO')return q+Number(x.qtdRecup||0);
      if(card==='BAIXA POR PERDA')return q+Number(x.qtdLixo||0);
      return q+Number(x.qtdTotal||0);
    },0);
  }
  function arrDemerito(){return sortByDate(base().filter(function(x){return inPeriodo(x)&&['DEB.MOTORISTA','VENCIDOS','DEV.FORNC','TROCA CLIENTE'].indexOf(x.destino)<0;}));}
  function arrDaily(){return sortByDate(base().filter(function(x){return inPeriodo(x)&&['LOTE DE AVARIA','BAIXA POR PERDA','RECUPERADO'].indexOf(x.destino)>=0;}));}
  function resumoDaily(){
    var map={};
    arrDaily().forEach(function(x){
      var d=iso(x.data);if(!d)return;
      if(!map[d])map[d]={total:0,lote:0,rec:0,lixo:0,perda:0};
      map[d].total+=Number(x.valorTotal||0);
      map[d].lote+=Number(x.vlrLoteAvaria||0);
      map[d].rec+=Number(x.vlrRecuperado||0);
      map[d].lixo+=Number(x.vlrLixo||0);
      map[d].perda=map[d].lote+map[d].lixo;
    });
    return Object.entries(map).sort();
  }
  function installFilter(){
    var status=$('statusBase');if(!status||!status.parentNode)return;
    ['filtroPeriodoV176','filtroPeriodoV177','filtroPeriodoV178','filtroPeriodoV179','filtroPeriodoV180'].forEach(function(fid){var old=$(fid);if(old)old.remove();});
    var box=$('filtroPeriodoV186');
    if(!box){box=document.createElement('div');box.id='filtroPeriodoV186';status.parentNode.insertBefore(box,status.nextSibling);}
    if(box.getAttribute('data-ready')!=='1'){
      box.setAttribute('data-ready','1');
      box.innerHTML='<div class="pmTituloV186">Período de Movimento</div><div class="pmLinhaV186"><label>Data inicial: <input id="dataIniV186" type="date"></label><label>Data final: <input id="dataFimV186" type="date"></label><button type="button" id="limparPeriodoV186">Limpar período</button><span id="infoPeriodoV186"></span></div>';
      $('dataIniV186').addEventListener('change',applyDates);
      $('dataFimV186').addEventListener('change',applyDates);
      $('limparPeriodoV186').onclick=function(){savePeriodo('','');syncFilter();renderUnified(active()||'LOTE DE AVARIA');};
    }
    syncFilter();
  }
  function syncFilter(){
    var p=periodo();
    if($('dataIniV186'))$('dataIniV186').value=p.ini||'';
    if($('dataFimV186'))$('dataFimV186').value=p.fim||'';
    if($('infoPeriodoV186'))$('infoPeriodoV186').textContent='Período: '+periodoTexto();
  }
  function applyDates(){
    var ini=($('dataIniV186')||{}).value||'', fim=($('dataFimV186')||{}).value||'';
    if(ini&&fim&&ini>fim){alert('A data inicial não pode ser maior que a data final.');syncFilter();return;}
    savePeriodo(ini,fim);syncFilter();renderUnified(active()||'LOTE DE AVARIA');
  }
  function renderTabsUnified(){
    var tabs=$('tabs');if(!tabs)return;
    var act=active()||'LOTE DE AVARIA',out='';
    allCards().forEach(function(card){
      var a=filtered(card),ac=(act===card?'active':'');
      if(card==='LOTE DE AVARIA'){
        out+='<button type="button" class="tab tabTotalV100 tabLoteV186 '+ac+'" onclick="toggleDestino(\''+attr(card)+'\')"><span class="tabNomeV100">LOTE DE AVARIA</span><span class="tabValorRealV186">Real: '+brl.format(realLote(a))+'</span><span class="tabValorSugV186">Sug.: '+brl.format(sugLote(a))+'</span><span class="tabQtdV100">'+a.length+' itens | Qtd '+qtdCard(card,a)+'</span></button>';
      }else{
        out+='<button type="button" class="tab tabTotalV100 '+ac+'" onclick="toggleDestino(\''+attr(card)+'\')"><span class="tabNomeV100">'+esc(card)+'</span><span class="tabValorV100">'+brl.format(totalCard(card,a))+'</span><span class="tabQtdV100">'+a.length+' itens | Qtd '+qtdCard(card,a)+'</span></button>';
      }
    });
    var dem=arrDemerito(),demTot=dem.reduce(function(s,x){return s+Number(x.valorTotal||0);},0),demQtd=dem.reduce(function(s,x){return s+Number(x.qtdTotal||0);},0);
    out+='<button type="button" class="tab tabTotalV100 tabEspecialV132 tabDemeritoV121 '+(act===DEM?'active':'')+'" onclick="toggleDestino(\''+DEM+'\')"><span class="tabNomeV100">DEMÉRITO</span><span class="tabValorV100">'+brl.format(demTot)+'</span><span class="tabQtdV100">'+dem.length+' itens | Qtd '+demQtd+'</span></button>';
    var rd=resumoDaily(),tv=rd.reduce(function(s,p){return s+Number(p[1].total||0);},0);
    out+='<button type="button" class="tab tabTotalV100 tabEspecialV132 tabValoresDiariosV122 '+(act===VAL?'active':'')+'" onclick="toggleDestino(\''+VAL+'\')"><span class="tabNomeV100">VALORES DIÁRIOS</span><span class="tabValorV100">'+brl.format(tv)+'</span><span class="tabQtdV100">'+periodoTexto()+' | '+rd.length+' dias</span></button>';
    tabs.innerHTML=out;
  }
  function renderDemeritoUnified(arr){
    arr=sortByDate(arr||arrDemerito());var body=$('demeritoBody');if(!body)return;
    body.innerHTML=arr.length?arr.map(function(x){return '<tr><td>'+fmtDate(x.data)+'</td><td>'+(x.turno||'')+'</td><td>'+x.codigo+'</td><td>'+x.descricao+'</td><td class="center">'+x.qtdTotal+'</td><td class="center">'+x.qtdRecup+'</td><td class="center">'+x.qtdLoteVenda+'</td><td class="center">'+x.qtdLixo+'</td><td class="num">'+brl.format(x.valorTotal)+'</td><td class="num">'+brl.format(x.vlrLoteAvaria)+'</td><td class="num">'+brl.format(x.vlrRecuperado)+'</td><td class="num">'+brl.format(x.vlrLixo)+'</td></tr>';}).join(''):'<tr><td colspan="12" class="center">Sem dados de demérito para o período selecionado.</td></tr>';
    var t=arr.reduce(function(a,x){a.total+=Number(x.valorTotal||0);a.lote+=Number(x.vlrLoteAvaria||0);a.rec+=Number(x.vlrRecuperado||0);a.lixo+=Number(x.vlrLixo||0);return a;},{total:0,lote:0,rec:0,lixo:0});
    if($('tTot'))$('tTot').innerText=brl.format(t.total);if($('tLote'))$('tLote').innerText=brl.format(t.lote);if($('tRec'))$('tRec').innerText=brl.format(t.rec);if($('tLixo'))$('tLixo').innerText=brl.format(t.lixo);
    if($('demeritoMesLabel'))$('demeritoMesLabel').textContent=periodoTexto();
    if($('fechamentoDemeritoInfo'))$('fechamentoDemeritoInfo').textContent='Demérito exibindo o período: '+periodoTexto()+' | '+arr.length+' lançamento(s).';
  }
  function renderDailyUnified(){
    var e=resumoDaily(),body=$('dailyBody');if(!body)return;
    body.innerHTML=e.length?e.map(function(p){var d=p[0],v=p[1];return '<tr><td>'+fmtDate(d)+'</td><td class="num">'+brl.format(v.total)+'</td><td class="num">'+brl.format(v.lote)+'</td><td class="num">'+brl.format(v.rec)+'</td><td class="num">'+brl.format(v.lixo)+'</td><td class="num">'+brl.format(v.perda)+'</td></tr>';}).join(''):'<tr><td colspan="6" class="center">Sem dados para o período selecionado.</td></tr>';
    var title=document.querySelector('.grid2 .card:nth-child(2) .miniTitle');if(title)title.textContent='VALORES DIÁRIOS - '+periodoTexto();
  }
  function renderUnified(card){
    if(rendering)return;rendering=true;
    try{
      card=card||active()||'LOTE DE AVARIA';setActive(card);installFilter();
      if(card===DEM){document.body.classList.add('modoDemeritoV121');document.body.classList.remove('modoValoresDiariosV122');if($('tableTitle'))$('tableTitle').textContent='DEMÉRITO POR AVARIA';renderDemeritoUnified(arrDemerito());renderDailyUnified();renderTabsUnified();return;}
      if(card===VAL){document.body.classList.remove('modoDemeritoV121');document.body.classList.add('modoValoresDiariosV122');if($('tableTitle'))$('tableTitle').textContent='VALORES DIÁRIOS';renderDemeritoUnified(arrDemerito());renderDailyUnified();renderTabsUnified();return;}
      document.body.classList.remove('modoDemeritoV121','modoValoresDiariosV122');
      var tb=$('tbody'),title=$('tableTitle');
      if(title)title.textContent=card;
      if(tb)tb.innerHTML='';
      var h=paintHeader(card),arr=filtered(card);
      if(tb){tb.innerHTML=arr.length?arr.map(function(x){return row(x);}).join(''):'<tr><td colspan="'+h.length+'" class="center">Sem lançamentos para este card no período selecionado.</td></tr>';}
      if(card==='VENCIDOS')applyVencidosNoWrap();
      renderDemeritoUnified(arrDemerito());renderDailyUnified();renderTabsUnified();paintHeader(card);
    }finally{rendering=false;}
  }
  function applyVencidosNoWrap(){
    document.querySelectorAll('#tbody tr td:nth-child(3)').forEach(function(td){td.classList.add('descVencidosV186');td.title=(td.textContent||'').replace(/\s+/g,' ').trim();});
  }
  function headersUnified(card){return paintHeader(card||active()||'LOTE DE AVARIA');}

  // Unico ponto de controle da tela.
  window.render=function(){renderUnified(active()||'LOTE DE AVARIA');};try{render=window.render;}catch(e){}
  window.toggleDestino=function(card){renderUnified(card);};try{toggleDestino=window.toggleDestino;}catch(e){}
  window.headers=headersUnified;try{headers=headersUnified;}catch(e){}
  window.filtrados=filtered;try{filtrados=filtered;}catch(e){}
  window.dadosValoresDiarios=arrDaily;try{dadosValoresDiarios=arrDaily;}catch(e){}
  window.filtrarDemeritoMensal=function(){return arrDemerito();};try{filtrarDemeritoMensal=window.filtrarDemeritoMensal;}catch(e){}
  window.renderTabs=renderTabsUnified;try{renderTabs=renderTabsUnified;}catch(e){}
  window.renderDemerito=renderDemeritoUnified;try{renderDemerito=renderDemeritoUnified;}catch(e){}

<!-- ============================================================
   TESTE - DEMERITO CABECALHO ALINHADO AO CORPO V226
   Base: V211 + filtro base limpa + LOTE abreviado.
   Ideia: medir as larguras reais da primeira linha do corpo do
   Demerito e aplicar essas larguras ao cabecalho via colgroup.
   Assim o cabecalho acompanha o corpo, e nao o contrario.
   ============================================================ -->
<script>
(function(){
  if(window.__v226DemeritoCabecalhoAoCorpo) return;
  window.__v226DemeritoCabecalhoAoCorpo = true;

  var titulos = [
    ['DATA AVARIA','DATA'],
    ['TURNO','TURNO'],
    ['COD ITEM','CÓD.'],
    ['DESCRIÇÃO','DESCRIÇÃO'],
    ['QTD TOTAL','QTD TOT.'],
    ['QTD RECUP','QTD REC.'],
    ['QTD LOTE','QTD LOTE'],
    ['QTD LIXO','QTD LIXO'],
    ['VALOR TOTAL','VLR TOTAL'],
    ['VLR LOTE','VLR LOTE'],
    ['VLR RECUP','VLR REC.'],
    ['VLR LIXO','VLR LIXO']
  ];

  function $(id){ return document.getElementById(id); }
  function norm(s){ return String(s||'').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[▼●▾]/g,'').replace(/\s+/g,' ').trim(); }
  function cardAtual(){
    try{ if(typeof selecionados !== 'undefined' && selecionados && selecionados.size) return Array.from(selecionados)[0] || ''; }catch(e){}
    var t=$('tableTitle'); return t ? String(t.textContent||'').trim() : '';
  }
  function ehLote(){ return norm(cardAtual()) === 'LOTE DE AVARIA'; }

  function garantirFiltroCodigoLote(){
    if(!ehLote()) return;
    var th = document.querySelector('#thead th:nth-child(1)');
    if(!th) return;
    th.setAttribute('data-filtro-titulo','CÓDIGO');
    th.setAttribute('data-titulo-completo-v218','CÓDIGO');
    th.setAttribute('title','CÓDIGO');
  }

  function limparTentativasAntigas(table){
    table.classList.remove(
      'demeritoAlinhadoV219',
      'demeritoColunasAlinhadasV220',
      'demeritoGradeFixaV221',
      'tabelaOriginalOcultaV222',
      'demeritoAjusteSeguroV223',
      'demeritoLarguraAjustadaV224',
      'demeritoMesmaLogicaLoteV225'
    );
    var grid = $('demeritoGridVisualV222');
    if(grid) grid.style.setProperty('display','none','important');
  }

  function primeiraLinhaReal(table){
    var linhas = Array.prototype.slice.call(table.querySelectorAll('tbody tr'));
    for(var i=0;i<linhas.length;i++){
      var tr = linhas[i];
      if(tr && tr.children && tr.children.length >= 12 && tr.offsetParent !== null){
        return tr;
      }
    }
    return null;
  }

  function abreviarTitulos(table){
    Array.prototype.slice.call(table.querySelectorAll('thead th')).forEach(function(th,i){
      if(!titulos[i]) return;
      th.textContent = titulos[i][1];
      th.setAttribute('title',titulos[i][0]);
      th.setAttribute('data-v226-full',titulos[i][0]);
    });
  }

  function alinharCabecalhoAoCorpo(){
    var table = $('demeritoTable');
    if(!table) return;
    limparTentativasAntigas(table);
    table.classList.add('demeritoCabecalhoAoCorpoV226');
    abreviarTitulos(table);

    // Garante que a tabela original esteja visivel, caso alguma tentativa anterior tenha ocultado.
    table.style.setProperty('display','table','important');
    table.style.setProperty('visibility','visible','important');
    table.style.setProperty('opacity','1','important');
    table.style.setProperty('height','auto','important');
    table.style.setProperty('max-height','none','important');

    var tr = primeiraLinhaReal(table);
    if(!tr) return;

    // Primeiro remove colgroup antigo para ler a largura natural atual do corpo.
    Array.prototype.slice.call(table.querySelectorAll('colgroup[data-v226="1"]')).forEach(function(cg){ cg.remove(); });

    var tds = Array.prototype.slice.call(tr.children).slice(0,12);
    var widths = tds.map(function(td){ return Math.max(28, Math.round(td.getBoundingClientRect().width)); });
    var soma = widths.reduce(function(a,b){ return a+b; },0);
    var tableWidth = Math.round(table.getBoundingClientRect().width || soma);

    // Se a soma estiver muito menor que a tabela, distribui a sobra proporcionalmente,
    // mantendo a referencia do corpo como base.
    if(tableWidth > soma + 8){
      var fator = tableWidth / soma;
      widths = widths.map(function(w){ return Math.max(28, Math.floor(w * fator)); });
    }

    var cg = document.createElement('colgroup');
    cg.setAttribute('data-v226','1');
    cg.innerHTML = widths.map(function(w){ return '<col style="width:'+w+'px">'; }).join('');
    table.insertBefore(cg, table.firstChild);

    Array.prototype.slice.call(table.querySelectorAll('thead th')).forEach(function(th,i){
      if(!widths[i]) return;
      th.style.setProperty('width', widths[i]+'px', 'important');
      th.style.setProperty('min-width', widths[i]+'px', 'important');
      th.style.setProperty('max-width', widths[i]+'px', 'important');
    });
  }

  function agendar(){
    setTimeout(function(){ garantirFiltroCodigoLote(); alinharCabecalhoAoCorpo(); },100);
    setTimeout(function(){ garantirFiltroCodigoLote(); alinharCabecalhoAoCorpo(); },400);
    setTimeout(function(){ garantirFiltroCodigoLote(); alinharCabecalhoAoCorpo(); },1200);
  }

  var renderAnt=window.render;
  if(typeof renderAnt==='function'){
    window.render=function(){ var r=renderAnt.apply(this,arguments); agendar(); return r; };
    try{ render=window.render; }catch(e){}
  }
  var toggleAnt=window.toggleDestino;
  if(typeof toggleAnt==='function'){
    window.toggleDestino=function(){ var r=toggleAnt.apply(this,arguments); agendar(); return r; };
    try{ toggleDestino=window.toggleDestino; }catch(e){}
  }
  var carregarAnt=window.carregarTudo;
  if(typeof carregarAnt==='function'){
    window.carregarTudo=function(){ var r=carregarAnt.apply(this,arguments); agendar(); return r; };
    try{ carregarTudo=window.carregarTudo; }catch(e){}
  }
  window.addEventListener('resize',function(){ setTimeout(alinharCabecalhoAoCorpo,250); });
  document.addEventListener('DOMContentLoaded',function(){ agendar(); setTimeout(agendar,1800); });
})();
</script>

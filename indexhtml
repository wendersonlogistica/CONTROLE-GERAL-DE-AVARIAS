function callGS(params,cb){let name='cb_'+Date.now()+Math.floor(Math.random()*9999);window[name]=resp=>{try{cb(resp)}finally{delete window[name]}};params.callback=name;let qs=Object.keys(params).map(k=>k+'='+encodeURIComponent(params[k])).join('&');let sc=document.createElement('script');sc.onerror=()=>{delete window[name];cb({ok:false,erro:'Falha ao acessar Apps Script'})};sc.src=APPS_SCRIPT_URL+'?'+qs+'&_='+Date.now();document.body.appendChild(sc);setTimeout(()=>{if(window[name]){delete window[name];cb({ok:false,erro:'Tempo esgotado'})}},25000)}
function todayISO(){let d=new Date();return new Date(d.getTime()-d.getTimezoneOffset()*60000).toISOString().slice(0,10)}function normDate(d){if(!d)return '';if(String(d).includes('/')){let p=String(d).split('/');return p.length===3?`${p[2]}-${p[1].padStart(2,'0')}-${p[0].padStart(2,'0')}`:d}return String(d).slice(0,10)}function fmtDate(d){d=String(d||'');return d.includes('/')?d:d.split('-').reverse().join('/')}function init(){if(logoData)$('logoImg').src=logoData;if(localStorage.getItem('temaAvarias')==='dark')document.body.classList.add('dark');$('data').value=todayISO();renderDestinosForm();renderReportSelect();renderTabs();setupEnterNav();calcular();carregarTudo();setInterval(carregarTudo,60000)}
function carregarTudo(){$('statusBase').textContent='Carregando base e lançamentos do Google Sheets...';callGS({action:'base'},resp=>{if(!resp||resp.ok===false){$('statusBase').textContent='Erro ao carregar base: '+(resp&&resp.erro||'sem resposta');return}setProdutos(resp.dados||[]);callGS({action:'listarLancamentos'},r=>{if(r&&r.ok!==false){lancamentos=(r.dados||[]).map(recalcularLancamento);$('statusBase').textContent=`Base atualizada: ${produtos.length} itens | Atualizado em ${new Date().toLocaleString('pt-BR')}`;render()}else $('statusBase').textContent='Base carregada, mas erro nos lançamentos: '+(r&&r.erro||'sem resposta')})})}function setProdutos(arr){produtos=(arr||[]).map(p=>({codigo:String(p.codigo||p.CODPROD||'').trim(),descricao:String(p.descricao||p.DESCRICAO||'').trim(),fornecedor:String(p.fornecedor||p.FORNECEDOR||'').trim(),valorVenda:Number(p.valorVenda||p.VALOR_VENDA||0),custo:Number(p.custo||p.VALOR_ULTIMA_ENTRADA||0)})).filter(p=>p.codigo);byCode=new Map(produtos.map(p=>[String(p.codigo),p]))}
function recalcularLancamento(x){let p=byCode.get(String(x.codigo));if(p){x.descricao=p.descricao;x.fornecedor=p.fornecedor;x.valorVenda=Number(p.valorVenda||0);x.custo=Number(p.custo||0)}x.data=normDate(x.data);x.qtdTotal=Number(x.qtdTotal||0);x.qtdRecup=Number(x.qtdRecup||0);x.qtdLoteVenda=Number(x.qtdLoteVenda||0);x.qtdLixo=Number(x.qtdLixo||0);x.desconto=Number(x.desconto||0.30);x.motAvaria=x.motAvaria||'';x.precoAvaria=+(x.valorVenda*(1-x.desconto)).toFixed(2);x.vlrLoteAvaria=+(x.custo*x.qtdLoteVenda).toFixed(2);x.vlrRecuperado=+(x.custo*x.qtdRecup).toFixed(2);x.vlrLixo=+(x.custo*x.qtdLixo).toFixed(2);x.valorTotal=+(x.vlrLoteAvaria+x.vlrRecuperado+x.vlrLixo).toFixed(2);return x}function totalVendaLote(x){return Number(x.valorVenda||0)*Number(x.qtdLoteVenda||0)}function sugestaoVendaLote(x){return Number(x.precoAvaria||0)*Number(x.qtdLoteVenda||0)}
function setupEnterNav(){let f=$('formAvaria');f.addEventListener('keydown',e=>{if(e.key!=='Enter')return;e.preventDefault();if(e.target.id==='codigo'&&!buscarExato())return;let fields=[...f.querySelectorAll('input,select,button')].filter(el=>!el.disabled&&!el.readOnly&&el.type!=='hidden'&&el.offsetParent!==null&&el.type!=='button');let i=fields.indexOf(e.target);if(i>=0&&i<fields.length-1)fields[i+1].focus()})}function toggleTheme(){document.body.classList.toggle('dark');localStorage.setItem('temaAvarias',document.body.classList.contains('dark')?'dark':'light')}function togglePanel(force){let p=$('painel');let show=typeof force==='boolean'?force:!p.classList.contains('open');p.classList.toggle('open',show);if(show)setTimeout(()=>$('codigo').focus(),100)}function enderecoCasaInput(n){let el=$('endereco'+n);if(!el)return;el.value=String(el.value||'').replace(/\D/g,'').slice(0,3);montarEndereco()}

  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]||c;});}
  function limpa(s){return String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().trim();}
  function money(n){try{return brl.format(Number(n||0));}catch(e){return 'R$ '+Number(n||0).toFixed(2).replace('.',',');}}
  function pick(o,ks){for(var i=0;i<ks.length;i++){if(o&&o[ks[i]]!==undefined&&o[ks[i]]!==null&&String(o[ks[i]]).trim()!=='')return o[ks[i]];}return '';}
  function normOrc(o,origem){
    o=o||{};

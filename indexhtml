<script>
(function(){
  if(window.__v210DebMotoristaInstalado) return;
  window.__v210DebMotoristaInstalado = true;

  function escV210(v){
    return String(v == null ? '' : v).replace(/[&<>\"]/g,function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c] || c;
    });
  }
  function fmtDataV210(v){
    try{ return typeof fmtDate === 'function' ? fmtDate(v) : String(v || ''); }
    catch(e){ return String(v || ''); }
  }
  function moedaV210(v){
    try{ return brl.format(Number(v || 0)); }
    catch(e){ return 'R$ ' + Number(v || 0).toFixed(2).replace('.',','); }
  }
  function acaoV210(x){
    try{ if(typeof action === 'function') return action(x); }catch(e){}
    return '<button class="light">Editar</button> <button class="danger">Excluir</button>';
  }
  function normalV210(s){
    return String(s || '').trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
  }

  var rowOriginalV210 = window.row || (typeof row === 'function' ? row : null);


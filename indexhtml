  var filtros = {};
  var baseCache = {};
  var menu = null;
  var estadoMenu = null;
  var permitidas = ['CODIGO','COD.','CÓD.','DESCRICAO','DESCRIÇÃO','FORNECEDOR'];

  function $(id){ return document.getElementById(id); }
  function qsa(sel,root){ return Array.prototype.slice.call((root||document).querySelectorAll(sel)); }
  function texto(el){ return String((el && el.textContent) || '').replace(/\s+/g,' ').trim(); }
  function normTitulo(s){ return String(s||'').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^A-Z0-9.]+/g,' ').trim(); }
  function normValor(s){ return String(s||'').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,' ').trim(); }
  function normBusca(s){ return String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,' ').trim(); }
  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c];}); }
  function cardAtual(){ try{ if(typeof selecionados!=='undefined' && selecionados && selecionados.size) return Array.from(selecionados)[0] || ''; }catch(e){} var t=$('tableTitle'); return t ? texto(t) : ''; }
  function especial(card){ var n=normTitulo(card); return n.indexOf('DEMERITO')>=0 || n.indexOf('VALORES DIARIOS')>=0; }
  function tituloLimpo(t){ return normTitulo(String(t||'').replace(/[▼●▾]/g,'')); }
  function permitido(t){ return permitidas.indexOf(tituloLimpo(t)) >= 0; }
  function chave(card,idx,titulo){ return String(card||'') + '||' + String(idx) + '||' + tituloLimpo(titulo); }
  function removerFiltroAntigo(){
    ['painelFiltroColunaV211','statusFiltroColunaV211','statusFiltroSimplesOkV215','statusFiltroSimplesV214','statusFiltroExcelLimpoV213','statusFiltroExcelV212','statusFiltroOkCorrV216'].forEach(function(id){ var el=$(id); if(el){ el.style.display='none'; el.textContent=''; } });
    qsa('#thead th').forEach(function(th){ th.classList.remove('thFiltroV211','filtroAtivoV211'); th.removeAttribute('title'); });
    try{ if(window.__v211FiltrosPorCard) window.__v211FiltrosPorCard = {}; }catch(e){}
  }
  function linhasDomAtuais(){ var tb=$('tbody'); if(!tb) return []; return qsa('tr',tb).filter(function(tr){ return tr.children && tr.children.length && !tr.querySelector('td[colspan]') && tr.id!=='linhaSemFiltroBaseLimpaV217'; }); }
  function snapshotBase(card){
    card = card || cardAtual();
    if(especial(card)) return;
    var rows = linhasDomAtuais().map(function(tr){
      var vals = qsa('td',tr).map(function(td){ return texto(td); });
      return {html:tr.outerHTML, valores:vals, valoresNorm:vals.map(normValor)};
    });
    if(rows.length) baseCache[card] = {rows:rows, criado:Date.now()};
  }
  function base(card){
    card = card || cardAtual();
    if(!baseCache[card] || !baseCache[card].rows || !baseCache[card].rows.length) snapshotBase(card);
    return (baseCache[card] && baseCache[card].rows) ? baseCache[card].rows : [];
  }
  function valoresColuna(idx){
    var map={};
    base(cardAtual()).forEach(function(r){ var v = r.valores[idx] || ''; if(v) map[normValor(v)] = v; });
    var vals=Object.keys(map).map(function(k){return map[k];});
    vals.sort(function(a,b){ return a.localeCompare(b,'pt-BR',{numeric:true}); });
    return vals;
  }
  function fecharMenu(){
    if(menu){ menu.remove(); menu=null; }
    estadoMenu=null;
    qsa('.filtroBaseLimpaBtnV217').forEach(function(b){ b.classList.remove('ativo'); });
    qsa('#mainTable thead th').forEach(function(th){ th.classList.remove('filtroBaseLimpaAbertoV217'); });
  }
  function instalarBotoes(){
    removerFiltroAntigo();
    var card=cardAtual(); if(especial(card)){ fecharMenu(); return; }
    qsa('#mainTable thead th').forEach(function(th,idx){
      var original=texto(th).replace(/[▼●▾]/g,'').trim(); if(!original) return;
      th.classList.remove('filtroBaseLimpaThV217');
      th.innerHTML='<span class="filtroBaseLimpaTituloV217">'+esc(original)+'</span>';
      if(!permitido(original)) return;
      th.classList.add('filtroBaseLimpaThV217');
      th.setAttribute('data-filtro-idx',idx);
      th.setAttribute('data-filtro-titulo',original);
      th.innerHTML='<span class="filtroBaseLimpaTituloV217">'+esc(original)+'</span><button type="button" class="filtroBaseLimpaBtnV217" title="Filtrar '+esc(original)+'" data-idx="'+idx+'" data-titulo="'+esc(original)+'">▾</button>';
      var btn=th.querySelector('.filtroBaseLimpaBtnV217');
      btn.onclick=function(ev){ ev.preventDefault(); ev.stopPropagation(); abrirMenu(btn,idx,original); };
    });
    atualizarVisual();
  }
  function abrirMenu(btn,idx,titulo){
    fecharMenu(); removerFiltroAntigo();
    snapshotBase(cardAtual());
    btn.classList.add('ativo'); var th=btn.closest('th'); if(th) th.classList.add('filtroBaseLimpaAbertoV217');
    var card=cardAtual(), vals=valoresColuna(idx), key=chave(card,idx,titulo);
    var atualNorm=filtros[key] ? filtros[key].slice() : vals.map(normValor);
    estadoMenu={card:card,idx:idx,titulo:titulo,key:key,todos:vals.slice(),selecionados:new Set(atualNorm)};
    menu=document.createElement('div'); menu.id='menuFiltroBaseLimpaV217';
    menu.innerHTML='<input class="pesquisaV217" type="text" placeholder="Pesquisar...">'
      +'<div class="linhaTopoV217"><label class="todosV217"><input type="checkbox" data-todos="1" '+(atualNorm.length===vals.length?'checked':'')+'><span>(Todos)</span></label><button type="button" class="limparV217" data-acao="limpar">Limpar</button></div>'
      +'<div class="listaV217">'
      + vals.map(function(v){ var nv=normValor(v); return '<label class="itemV217" data-busca="'+esc(normBusca(v))+'"><input type="checkbox" '+(estadoMenu.selecionados.has(nv)?'checked':'')+' value="'+esc(nv)+'"><span title="'+esc(v)+'">'+esc(v)+'</span></label>'; }).join('')
      +'</div><div class="rodapeV217"><div class="infoV217"></div><div class="btnsV217"><button type="button" class="cancelarV217" data-acao="cancelar">Cancelar</button><button type="button" class="okV217" data-acao="ok">OK</button></div></div>';
    document.body.appendChild(menu);
    var r=btn.getBoundingClientRect();
    menu.style.left=Math.min(Math.max(4,r.left), window.innerWidth-230)+'px';
    menu.style.top=Math.min(r.bottom+2, window.innerHeight-42)+'px';

    var input=menu.querySelector('.pesquisaV217');
    var todosCb=menu.querySelector('input[data-todos="1"]');
    function todosNorm(){ return estadoMenu.todos.map(normValor); }
    function atualizarChecks(){
      qsa('.itemV217 input',menu).forEach(function(cb){ cb.checked=estadoMenu.selecionados.has(cb.value); });
      todosCb.checked=estadoMenu.selecionados.size===estadoMenu.todos.length;
      var inf=menu.querySelector('.infoV217');
      if(inf) inf.textContent=estadoMenu.selecionados.size+' de '+estadoMenu.todos.length;
    }
    function confirmar(){
      var sel=Array.from(estadoMenu.selecionados);
      if(sel.length===estadoMenu.todos.length) delete filtros[estadoMenu.key]; else filtros[estadoMenu.key]=sel;
      fecharMenu();
      aplicarFiltros();
      atualizarVisual();
    }
    function selecionarPorPesquisa(){
      var t=normBusca(input.value);
      if(!t){
        estadoMenu.selecionados=new Set(todosNorm());
        qsa('.itemV217',menu).forEach(function(item){ item.style.display='flex'; });
        atualizarChecks();
        return;
      }
      var achados=[];
      qsa('.itemV217',menu).forEach(function(item){
        var ok=item.getAttribute('data-busca').indexOf(t)>=0;
        item.style.display=ok?'flex':'none';
        if(ok){ var cb=item.querySelector('input'); achados.push(cb.value); }
      });
      estadoMenu.selecionados=new Set(achados);
      atualizarChecks();
    }
    input.oninput=selecionarPorPesquisa;
    input.onkeydown=function(e){
      if(e.key==='Enter'){ e.preventDefault(); selecionarPorPesquisa(); confirmar(); }
      if(e.key==='Escape'){ e.preventDefault(); fecharMenu(); }
    };
    todosCb.onchange=function(){
      estadoMenu.selecionados = todosCb.checked ? new Set(todosNorm()) : new Set();
      input.value=''; qsa('.itemV217',menu).forEach(function(item){ item.style.display='flex'; }); atualizarChecks();
    };
    qsa('.itemV217 input',menu).forEach(function(cb){
      cb.onchange=function(){ if(cb.checked) estadoMenu.selecionados.add(cb.value); else estadoMenu.selecionados.delete(cb.value); atualizarChecks(); };
    });
    menu.addEventListener('click',function(ev){
      var ac=ev.target && ev.target.getAttribute('data-acao');
      if(ac==='ok'){ ev.preventDefault(); confirmar(); }
      if(ac==='cancelar'){ ev.preventDefault(); fecharMenu(); }
      if(ac==='limpar'){
        ev.preventDefault();
        delete filtros[estadoMenu.key];
        estadoMenu.selecionados=new Set(todosNorm());
        input.value='';
        qsa('.itemV217',menu).forEach(function(item){ item.style.display='flex'; });
        atualizarChecks();
        aplicarFiltros();
        atualizarVisual();
      }
    });
    atualizarChecks();
    setTimeout(function(){ input.focus(); input.select(); },30);
  }
  function aplicarFiltros(){
    removerFiltroAntigo();
    var card=cardAtual(), rows=base(card), ativos=[];
    Object.keys(filtros).forEach(function(k){ var p=k.split('||'); if(p[0]===String(card)) ativos.push({idx:Number(p[1]), vals:filtros[k].map(normValor)}); });
    var filtradas = rows.filter(function(r){
      var ok=true;
      ativos.forEach(function(f){ if(f.vals.indexOf(r.valoresNorm[f.idx] || '')<0) ok=false; });
      return ok;
    });
    var tb=$('tbody'); if(!tb) return;
    if(!ativos.length) filtradas = rows;
    if(filtradas.length){
      tb.innerHTML = filtradas.map(function(r){ return r.html; }).join('');
    }else{
      var cols=qsa('#mainTable thead th').length||1;
      tb.innerHTML='<tr id="linhaSemFiltroBaseLimpaV217"><td colspan="'+cols+'" class="center">Nenhum registro encontrado com os filtros selecionados.</td></tr>';
    }
  }
  function atualizarVisual(){
    var card=cardAtual();
    qsa('.filtroBaseLimpaBtnV217').forEach(function(btn){ var idx=Number(btn.getAttribute('data-idx')), tit=btn.getAttribute('data-titulo')||''; btn.classList.toggle('filtrado', !!filtros[chave(card,idx,tit)]); });
  }
  function limparTodos(){
    var card=cardAtual(); Object.keys(filtros).forEach(function(k){ if(k.indexOf(String(card)+'||')===0) delete filtros[k]; });
    fecharMenu(); aplicarFiltros(); atualizarVisual();
  }
  window.limparTodosFiltrosBaseLimpaV217=limparTodos;

  var renderAnt=window.render; if(typeof renderAnt==='function'){
    window.render=function(){ var r=renderAnt.apply(this,arguments); var card=cardAtual(); setTimeout(function(){ snapshotBase(cardAtual()); instalarBotoes(); aplicarFiltros(); },50); setTimeout(function(){ snapshotBase(cardAtual()); instalarBotoes(); aplicarFiltros(); },220); return r; };
    try{ render=window.render; }catch(e){}
  }
  var toggleAnt=window.toggleDestino; if(typeof toggleAnt==='function'){
    window.toggleDestino=function(){ fecharMenu(); var r=toggleAnt.apply(this,arguments); setTimeout(function(){ snapshotBase(cardAtual()); instalarBotoes(); aplicarFiltros(); },90); setTimeout(function(){ snapshotBase(cardAtual()); instalarBotoes(); aplicarFiltros(); },260); return r; };
    try{ toggleDestino=window.toggleDestino; }catch(e){}
  }
  var carregarAnt=window.carregarTudo; if(typeof carregarAnt==='function'){
    window.carregarTudo=function(){ var r=carregarAnt.apply(this,arguments); setTimeout(function(){ baseCache={}; snapshotBase(cardAtual()); instalarBotoes(); aplicarFiltros(); },1400); setTimeout(function(){ snapshotBase(cardAtual()); instalarBotoes(); aplicarFiltros(); },2900); return r; };
    try{ carregarTudo=window.carregarTudo; }catch(e){}
  }
  document.addEventListener('click',function(ev){ if(menu && !ev.target.closest('#menuFiltroBaseLimpaV217') && !ev.target.closest('.filtroBaseLimpaBtnV217')) fecharMenu(); }, true);
  window.addEventListener('resize',fecharMenu);
  document.addEventListener('DOMContentLoaded',function(){ setTimeout(function(){ snapshotBase(cardAtual()); instalarBotoes(); aplicarFiltros(); },900); setTimeout(function(){ snapshotBase(cardAtual()); instalarBotoes(); aplicarFiltros(); },2200); });
})();
</script>



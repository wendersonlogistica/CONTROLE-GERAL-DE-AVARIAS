/* ============================================================
   V98 TESTE - LISTA AUTOMATICA DE PALETES NO ORCAMENTO
   - Ao escolher tipo "Por palete", o campo vira lista.
   - Lista carregada pelos paletes existentes no card escolhido.
   - Mostra resumo do palete: itens, qtd e valor.
   ============================================================ */
function fmtDateV98(d){
  if(typeof fmtDateV97==='function') return fmtDateV97(d);
  if(!d)return '';
  let s=String(d).trim();
  if(/^\d{2}\/\d{2}\/\d{4}$/.test(s))return s;
  if(/^\d{2}-\d{2}-\d{4}$/.test(s))return s.replace(/-/g,'/');
  if(/^\d{4}-\d{2}-\d{2}/.test(s)){let p=s.slice(0,10).split('-');return p[2]+'/'+p[1]+'/'+p[0];}
  return s;
}
function valorLinhaOrcV98(x,card){
  if(typeof valorLinhaOrcV97==='function') return valorLinhaOrcV97(x,card);
  let qtd=0,unit=0,total=0;
  if(card==='LOTE DE AVARIA'){
    qtd=Number(x.qtdLoteVenda||0);
    unit=Number(x.precoAvaria||0)||Number(x.valorVenda||0)*(1-Number(x.desconto||0));
    total=unit*qtd;
  }else if(card==='VENCIDOS'){
    qtd=Number(x.qtdTotal||0);unit=Number(x.custo||0);total=unit*qtd;
  }else{
    qtd=Number(x.qtdTotal||0);unit=Number(x.custo||x.precoAvaria||x.valorVenda||0);total=unit*qtd;
  }
  return {qtd:qtd,unit:unit,total:total};
}
function paletesDisponiveisV98(card){
  let arr=(typeof lancamentos!=='undefined'?lancamentos:[]).filter(x=>x.destino===card);
  let mapa={};
  arr.forEach(x=>{
    let p=String(x.palete||'').trim();
    if(!p)return;
    if(!mapa[p])mapa[p]={palete:p,itens:0,qtd:0,total:0};
    let v=valorLinhaOrcV98(x,card);
    mapa[p].itens+=1;
    mapa[p].qtd+=Number(v.qtd||0);
    mapa[p].total+=Number(v.total||0);
  });
  return Object.values(mapa).sort((a,b)=>String(a.palete).localeCompare(String(b.palete),'pt-BR',{numeric:true}));
}

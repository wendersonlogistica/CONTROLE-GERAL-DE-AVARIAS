     - Nao alterar calculos, periodo, orcamento, Demerito ou Valores Diarios.
     Como aplicar: colar antes de </body> na V208.
     ============================================================ -->
<script>
(function(){
  if(window.__v209LargurasDescricaoFornecedorInstalado) return;
  window.__v209LargurasDescricaoFornecedorInstalado = true;

  function normalizarV209(s){
    return String(s || '')
      .trim()
      .toUpperCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g,'');
  }

  function cardAtualV209(){
    var titulo = document.getElementById('tableTitle');
    var txt = titulo ? normalizarV209(titulo.textContent) : '';
    if(!txt){
      try{
        if(window.selecionados && selecionados.size){
          txt = normalizarV209(Array.from(selecionados)[0]);
        }
      }catch(e){}
    }
    return txt || 'LOTE DE AVARIA';
  }

  function aplicarCardClasseV209(){
    var card = cardAtualV209();
    document.body.classList.remove(
      'v209-card-lote','v209-card-recuperado','v209-card-baixa','v209-card-vencidos',
      'v209-card-dev','v209-card-troca','v209-card-deb','v209-card-especial'
    );
    var main = document.getElementById('mainTable');
    if(main){
      main.classList.remove(
        'v209-card-lote','v209-card-recuperado','v209-card-baixa','v209-card-vencidos',
        'v209-card-dev','v209-card-troca','v209-card-deb','v209-card-especial'
      );
    }

    var cls = 'v209-card-lote';
    if(card.indexOf('RECUPERADO') >= 0) cls = 'v209-card-recuperado';
    else if(card.indexOf('BAIXA POR PERDA') >= 0) cls = 'v209-card-baixa';
    else if(card.indexOf('VENCIDOS') >= 0) cls = 'v209-card-vencidos';
    else if(card.indexOf('DEV') >= 0) cls = 'v209-card-dev';
    else if(card.indexOf('TROCA CLIENTE') >= 0) cls = 'v209-card-troca';
    else if(card.indexOf('DEB') >= 0 || card.indexOf('MOTORISTA') >= 0) cls = 'v209-card-deb';
    else if(card.indexOf('DEMERITO') >= 0 || card.indexOf('VALORES DIARIOS') >= 0) cls = 'v209-card-especial';

    document.body.classList.add(cls);
    if(main) main.classList.add(cls);

    var table = document.getElementById('mainTable');
    if(table){
      table.style.setProperty('table-layout','fixed','important');
      table.style.setProperty('width','100%','important');
    }
  }

  function instalarV209(){
    aplicarCardClasseV209();
    setTimeout(aplicarCardClasseV209, 80);
    setTimeout(aplicarCardClasseV209, 260);
  }

  var oldToggle = window.toggleDestino;
  if(typeof oldToggle === 'function'){
    window.toggleDestino = function(){
      var r = oldToggle.apply(this, arguments);
      instalarV209();
      return r;
    };
    try{ toggleDestino = window.toggleDestino; }catch(e){}
  }

  var oldRender = window.render;
  if(typeof oldRender === 'function'){
    window.render = function(){
      var r = oldRender.apply(this, arguments);
      instalarV209();
      return r;
    };
    try{ render = window.render; }catch(e){}
  }

  document.addEventListener('DOMContentLoaded', function(){
    setTimeout(instalarV209, 400);
    setTimeout(instalarV209, 1200);
    setTimeout(instalarV209, 2500);
  });
  window.addEventListener('resize', function(){ setTimeout(instalarV209, 150); });
})();
</script>

  var OPERACIONAIS = ['LOTE DE AVARIA','RECUPERADO','BAIXA POR PERDA','VENCIDOS','DEV.FORNC','TROCA CLIENTE','DEB.MOTORISTA'];

  function $(id){ return document.getElementById(id); }

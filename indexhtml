      +'<div><label>Status</label><select id="filtroStatusOrcV161"><option value="">Todos</option><option value="AGUARDANDO APROVACAO" selected>Aguardando aprovação</option><option value="APROVADO">Aprovado</option><option value="REPROVADO">Reprovado</option><option value="VENDIDO / BAIXADO">Vendido / baixado</option><option value="CANCELADO">Cancelado</option></select></div>'
      +'<div><label>Buscar</label><input id="filtroTextoOrcV161" placeholder="Número, comprador ou card"></div>'

<script>
/* ============================================================
   V230 ESTAVEL - ROTINAS CENTRAIS SEM RECARREGAMENTO PESADO
   Objetivos:
   1) Reduzir oscilacao: nao adiciona wrappers em render/carregarTudo.
   2) Apos adicionar item: limpa formulario para novo lancamento.
   3) Apos salvar lista: limpa lista + formulario imediatamente.
   4) Limpar card: zera card e tabela na hora, sem esperar carregarTudo.
   5) Evita duplo clique/salvamento duplicado.
   ============================================================ */
(function(){
  var salvandoListaV230=false;
  var ultimaLimpezaCardV230=0;
  function $(id){return document.getElementById(id);}
  function norm(v){return String(v||'').trim().toUpperCase();}
  function fila(){try{return JSON.parse(localStorage.getItem('filaLancamentosV130')||'[]')}catch(e){return []}}
  function setFila(a){localStorage.setItem('filaLancamentosV130',JSON.stringify(a||[]));try{if(typeof renderFilaV130==='function')renderFilaV130();}catch(e){}}
  function status(msg){var st=$('statusBase');if(st)st.textContent=msg;}
  function senhaAdminAtual(senhaCallback){
    var s=String(senhaCallback||'').trim();
    if(!s && typeof senhaUsuarioAtualV106==='function'){
      try{s=String(senhaUsuarioAtualV106()||'').trim();}catch(e){}
    }
    return s||'95969268100';
  }
  function cardAtual(){
    var card='';
    try{card=typeof cardRelatorio==='function'?cardRelatorio():'';}catch(e){}
    if(!card || card==='CARD ATUAL'){
      try{card=(selecionados&&selecionados.size)?Array.from(selecionados)[0]:'';}catch(e){}
    }
    if(!card){var t=$('tableTitle');if(t)card=String(t.textContent||'').trim();}
    return card;
  }
  function limparFormularioNovoLancamento(){
    try{if(typeof limparForm==='function')limparForm(false);}catch(e){}
    try{
      ['codigo','descricao','fornecedor','valorVenda','custo','qtdTotal','qtdLote','qtdRecup','qtdLixo','vlrPerda','precoAvaria','valorTotal','vlrLote','vlrRecup','vlrLixo','palete','turno','motAvaria','motPerda','validade','motDevolucao','motTroca','observacao'].forEach(function(id){var el=$(id);if(el)el.value='';});
      ['endereco','endereco1','endereco2','endereco3','endereco4'].forEach(function(id){var el=$(id);if(el)el.value='';});
      var est=$('estado');if(est)est.value='A';
      var data=$('data');if(data&&typeof todayISO==='function')data.value=todayISO();
      document.querySelectorAll('input[name="destinoManual"]').forEach(function(c){c.checked=false;if(c.parentElement)c.parentElement.classList.remove('active');});
      if(typeof calcular==='function')calcular();
      var cod=$('codigo');if(cod)setTimeout(function(){cod.focus({preventScroll:true});},80);
    }catch(e){}
  }
  function limparFiltrosVisuais(){
    try{if(typeof limparTodosFiltrosBaseLimpaV217==='function')limparTodosFiltrosBaseLimpaV217();}catch(e){}
    try{var m=$('menuFiltroBaseLimpaV217');if(m)m.remove();}catch(e){}
    try{document.querySelectorAll('.filtroBaseLimpaBtnV217').forEach(function(b){b.classList.remove('filtrado','ativo');});}catch(e){}
  }
  function removerLancamentosDoCardLocal(card){
    try{
      if(Array.isArray(window.lancamentos)){
        window.lancamentos=window.lancamentos.filter(function(x){return norm(x&&x.destino)!==norm(card);});
        try{lancamentos=window.lancamentos;}catch(e){}
      }else if(Array.isArray(lancamentos)){
        lancamentos=lancamentos.filter(function(x){return norm(x&&x.destino)!==norm(card);});
        window.lancamentos=lancamentos;
      }
    }catch(e){}
  }
  function limparTabelaCardAtual(card){
    if(norm(cardAtual())!==norm(card))return;
    var tb=$('tbody');
    if(tb){
      var cols=(document.querySelectorAll('#thead th')||[]).length||1;
      tb.innerHTML='<tr id="linhaCardLimpoV230"><td colspan="'+cols+'" class="center">Card limpo. Nenhum lançamento encontrado.</td></tr>';
    }
  }
  function atualizarTelaCardLimpo(card){
    limparFiltrosVisuais();
    removerLancamentosDoCardLocal(card);
    try{if(typeof renderTabs==='function')renderTabs();}catch(e){}
    try{if(typeof render==='function')render();}catch(e){}
    limparTabelaCardAtual(card);
    status('Card '+card+' limpo na tela. Clique em Atualizar base e lançamentos apenas se quiser confirmar no Google Sheets.');
  }
  function payloadLimpo(lista){
    return (lista||[]).map(function(x){
      var y={};
      ['destino','codigo','descricao','fornecedor','valorVenda','custo','qtdTotal','qtdLoteVenda','qtdRecup','qtdLixo','estado','desconto','endereco','data','palete','turno','motAvaria','motPerda','validade','motDevolucao','motTroca','observacao','precoAvaria','valorTotal','vlrLoteAvaria','vlrRecuperado','vlrLixo'].forEach(function(k){if(x&&x[k]!==undefined)y[k]=x[k];});
      return y;
    });
  }
  function setBotoesSalvarLista(disabled){
    try{
      var box=$('listaPendenteV130');if(box)box.classList.toggle('salvandoV230',!!disabled);
      document.querySelectorAll('#listaPendenteV130 button').forEach(function(b){b.disabled=!!disabled;});
    }catch(e){}
  }
  var salvarOriginal=window.salvar;
  if(typeof salvarOriginal==='function'){
    window.salvar=function(e){
      var antes=fila().length;
      var r=salvarOriginal.apply(this,arguments);
      setTimeout(function(){
        var depois=fila().length;
        if(depois>antes){
          limparFormularioNovoLancamento();
          status('Lançamento adicionado à lista. Tela pronta para novo lançamento. Pendentes: '+depois+'.');
        }
      },180);
      return r;
    };
    try{salvar=window.salvar;}catch(e){}
  }
  window.salvarFilaV130=function(){
    if(salvandoListaV230){alert('A lista já está sendo salva. Aguarde finalizar.');return;}
    var a=fila();
    if(!a.length){alert('Nenhum lançamento pendente para salvar.');return;}
    if(!confirm('Salvar '+a.length+' lançamento(s) no Google Sheets agora?'))return;
    salvandoListaV230=true;
    setBotoesSalvarLista(true);
    status('Salvando lista com '+a.length+' lançamento(s) no Google Sheets...');
    callGS({action:'salvarLancamentos',payload:JSON.stringify(payloadLimpo(a))},function(r){
      salvandoListaV230=false;
      setBotoesSalvarLista(false);
      if(r&&r.ok){
        setFila([]);
        limparFormularioNovoLancamento();
        status('Lista salva com sucesso. Tela pronta para novos lançamentos. Use Atualizar base se quiser recarregar agora.');
      }else{
        alert('Erro ao salvar lista: '+((r&&r.erro)||'sem resposta')+'\n\nA lista foi mantida para evitar duplicidade. Antes de clicar de novo, use Atualizar base e confira se o item já entrou.');
        status('Falha ao salvar. Lista mantida para evitar duplicidade.');
      }
    });
  };
  window.limparCardAdmin=function(){
    var card=cardAtual();
    if(!card){alert('Selecione um card antes de limpar os lançamentos.');return;}
    if(Date.now()-ultimaLimpezaCardV230<3000){alert('Aguarde alguns segundos antes de limpar novamente.');return;}
    if(!confirm('ATENÇÃO: serão apagados definitivamente os lançamentos do card '+card+' na base Google Sheets. Deseja continuar?'))return;
    var conf=prompt('Para confirmar, digite LIMPAR');
    if(norm(conf)!=='LIMPAR'){alert('Confirmação cancelada.');return;}
    var executar=function(senhaRecebida){
      ultimaLimpezaCardV230=Date.now();
      var senha=senhaAdminAtual(senhaRecebida);
      status('Limpando lançamentos do card '+card+'...');
      callGS({action:'limparCard',card:card,confirmacao:'LIMPAR',senha:senha},function(r){
        if(r&&r.ok){
          alert('Limpeza concluída. Card: '+card+' | Linhas removidas: '+(r.removidos||0));
          atualizarTelaCardLimpo(card);
        }else{
          alert('Erro ao limpar card: '+((r&&r.erro)||'sem resposta'));
          status('Erro ao limpar card.');
        }
      });
    };
    if(typeof exigirAdminV106==='function')exigirAdminV106(executar);
    else if(typeof senhaAdminOcultaV103==='function')senhaAdminOcultaV103('Limpar lançamentos do card',executar);
    else if(typeof senhaAdminOcultaV81==='function')senhaAdminOcultaV81('Limpar lançamentos do card',executar);
    else{var sp=prompt('Digite a senha de administrador');if(!sp){alert('Senha não informada.');return;}executar(sp);}
  };
})();
</script>


      }catch(e){
        tbody.innerHTML = '<tr><td colspan="'+hs.length+'" class="center">Erro ao montar card.</td></tr>';
      }
    }

    // Atualiza os cards apenas uma vez, sem ciclos e sem setTimeout.
    try{ if(typeof renderTabs==='function') renderTabs(); }catch(e){}

    aplicarVisualV206(card);
  }

  window.toggleDestino = function(card){
    if(isEspecial(card)){
      if(typeof oldToggleV206==='function') return oldToggleV206.apply(this, arguments);
      setActive(card);
      return;
    }
    return renderCardNormalV206(card || 'LOTE DE AVARIA');
  };
  try{toggleDestino=window.toggleDestino;}catch(e){}

  window.render = function(){
    var card=activeCard();
    if(isEspecial(card)){
      if(typeof oldRenderV206==='function') return oldRenderV206.apply(this, arguments);
      return;
    }
    return renderCardNormalV206(card);
  };
  try{render=window.render;}catch(e){}

  document.addEventListener('DOMContentLoaded',function(){
    setTimeout(function(){aplicarVisualV206(activeCard());},700);
  });
})();
</script>

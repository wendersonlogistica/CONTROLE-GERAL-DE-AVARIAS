    return String(s || '').toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^A-Z0-9.]+/g,' ').trim();
  }
  function cardAtual(){
    try{
      if(typeof selecionados !== 'undefined' && selecionados && selecionados.size){
        return Array.from(selecionados)[0] || '';
      }
    }catch(e){}
    var title = $('tableTitle');
    return title ? String(title.textContent || '') : '';
  }
  function ehEspecial(card){
    var n = norm(card);
    return n.indexOf('DEMERITO') >= 0 || n.indexOf('VALORES DIARIOS') >= 0;
  }
  function ehOperacional(card){
    if(ehEspecial(card)) return false;
    var n = norm(card);

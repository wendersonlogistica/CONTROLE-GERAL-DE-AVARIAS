const GAS_URL_V109 = 'https://script.google.com/macros/s/AKfycbzPdCIRsQJDUTDrP8GNUVUY1f-IglYeC-HACSNLp9y2jmCDGHJUc-cYSdnW7m105M5u/exec';
const GAS_TIMEOUT_V109 = 90000;
function callGSV109(params, cb, tentativa){
  tentativa = tentativa || 1;
  params = params || {};
  let callbackName = 'cb_v109_' + Date.now() + '_' + Math.floor(Math.random()*1000000);
  params.callback = callbackName;
  let query = Object.keys(params).map(function(k){return encodeURIComponent(k)+'='+encodeURIComponent(params[k]);}).join('&');
  let script = document.createElement('script');
  let done = false;
  let timer = setTimeout(function(){
    if(done)return;
    done = true;
    try{delete window[callbackName];}catch(e){}
    try{script.remove();}catch(e){}
    if(tentativa < 2){
      let st=document.getElementById('statusBase');
      if(st)st.textContent='Base demorou para responder. Tentando novamente...';
      setTimeout(function(){callGSV109(params,cb,tentativa+1);},1200);
    }else{
      cb({ok:false,erro:'Tempo esgotado'});
    }
  }, GAS_TIMEOUT_V109);
  window[callbackName] = function(resp){
    if(done)return;
    done = true;
    clearTimeout(timer);
    try{delete window[callbackName];}catch(e){}
    try{script.remove();}catch(e){}
    cb(resp);
  };
  script.onerror = function(){
    if(done)return;
    done = true;
    clearTimeout(timer);
    try{delete window[callbackName];}catch(e){}
    try{script.remove();}catch(e){}
    if(tentativa < 2) setTimeout(function(){callGSV109(params,cb,tentativa+1);},1200);
    else cb({ok:false,erro:'Falha ao conectar ao Apps Script'});
  };
  script.src = GAS_URL_V109 + '?' + query;
  document.head.appendChild(script);
}
window.callGS = callGSV109;




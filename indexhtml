   - Modal com lista de orcamentos gravados: Sheets + localStorage.
   - Filtros por status, numero/comprador/card.
   - Visualizar itens do orcamento selecionado.
   - Ainda nao aprova/baixa: esta etapa e somente consulta.
   ============================================================ */
(function(){
  var cacheOrcV161=[];
  var cacheItensV161={};
  function escV161(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]||c;});}
  function moneyV161(n){try{return brl.format(Number(n||0));}catch(e){return 'R$ '+Number(n||0).toFixed(2).replace('.',',');}}
  function localOrcsV161(){
    var keys=['orcamentosPendentesV159','orcamentosPendentesV158','orcamentosPendentesV157'];
    var out=[];
    keys.forEach(function(k){
      try{var arr=JSON.parse(localStorage.getItem(k)||'[]');if(Array.isArray(arr))arr.forEach(function(x){x.__origem='Local';out.push(x);});}catch(e){}
    });
    return out;
  }
  function mergeOrcsV161(a,b){
    var map={};
    (a||[]).concat(b||[]).forEach(function(x){
      if(!x)return;
      var n=String(x.numero||x.NUMERO_ORCAMENTO||'').trim();
      if(!n)return;
      if(!map[n] || map[n].__origem==='Local')map[n]=x;
    });
    return Object.keys(map).map(function(k){return map[k];}).sort(function(x,y){return String(y.numero||'').localeCompare(String(x.numero||''),'pt-BR',{numeric:true});});
  }
  function normalizarOrcV161(x,origem){
    x=x||{};
    return {
      numero:x.numero||x.NUMERO_ORCAMENTO||'',
      status:x.status||x.STATUS||'AGUARDANDO APROVACAO',
      criadoEm:x.criadoEmBR||x.criadoEm||x.CRIADO_EM_BR||x.CRIADO_EM||'',
      usuario:x.usuario||x.USUARIO||'',
      cliente:x.cliente||x.CLIENTE||'',
      documento:x.documento||x.CPF_CNPJ||'',
      card:x.card||x.CARD||'',
      tipo:x.tipo||x.TIPO||'',
      qtdItens:Number(x.qtdItens||x.QTD_ITENS||0),
      qtdUnidades:Number(x.qtdUnidades||x.QTD_UNIDADES||0),
      total:Number(x.total||x.TOTAL||0),
      observacao:x.observacao||x.OBSERVACAO||'',
      itens:x.itens||[],
      __origem:origem||x.__origem||'Sheets'
    };
  }
  function garantirModalV161(){

    x = x || {};
    var qtd = Number(x.qtdTotal || 0);
    var custo = Number(x.custo || 0);
    var total = custo * qtd;
    var acoes = forExport ? '' : '<td class="colAcoesV206 colAcoesV210">' + acaoV210(x) + '</td>';
    return '<tr data-card-row-v210="DEB.MOTORISTA">' +
      '<td title="'+escV210(x.codigo)+'">'+escV210(x.codigo)+'</td>' +
      '<td title="'+escV210(fmtDataV210(x.data))+'">'+escV210(fmtDataV210(x.data))+'</td>' +

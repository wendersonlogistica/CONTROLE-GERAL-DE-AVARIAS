    if(reg&&Array.isArray(reg.itens)&&reg.itens.length){renderItensV161(numero,reg.itens);return;}
    if(cacheItensV161[numero]){renderItensV161(numero,cacheItensV161[numero]);return;}
    if(typeof callGS==='function'){
      try{
        callGS({action:'listarItensOrcamento',numero:numero},function(r){
          var itens=(r&&r.ok&&Array.isArray(r.dados))?r.dados:[];
          cacheItensV161[numero]=itens;
          renderItensV161(numero,itens);
        });
      }catch(e){renderItensV161(numero,[]);}
    }else renderItensV161(numero,[]);

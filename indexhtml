function montarEndereco(){let p=[1,2,3,4].map(n=>String(($('endereco'+n)||{}).value||'').trim());$('endereco').value=p.join('-');return $('endereco').value}
function enderecoCompletoValido(){let p=[1,2,3,4].map(n=>String(($('endereco'+n)||{}).value||'').trim());return p.every(v=>/^\d{1,3}$/.test(v))}
function formatEndereco(){let v=String($('endereco').value||'');let parts=v.split(/\D+/).filter(Boolean).slice(0,4);[1,2,3,4].forEach((n,i)=>{let el=$('endereco'+n);if(el)el.value=(parts[i]||'').slice(0,3)});montarEndereco()}function renderDestinosForm(){$('destinosBox').innerHTML=destinos.map(d=>`<label class="destBox ${manuais.includes(d)?'manual':'auto'}"><input type="checkbox" name="destinoManual" value="${d}" ${manuais.includes(d)?'':'disabled'} onchange="atualizaDestinoAuto()"> ${d}</label>`).join('')}function renderReportSelect(){$('reportCard').innerHTML=['CARD ATUAL',...destinos].map(d=>`<option value="${d}">${d}</option>`).join('')}function renderTabs(){$('tabs').innerHTML=destinos.map(d=>`<button class="tab ${selecionados.has(d)?'active':''}" onclick="toggleDestino('${d}')">${d}</button>`).join('')}function toggleDestino(d){selecionados=new Set([d]);renderTabs();render()}
function buscarProduto(){let q=String($('codigo').value||'').trim().toLowerCase(),box=$('suggestBox');if(!q){box.style.display='none';return}let ex=byCode.get(q.replace(/[^0-9]/g,''))||byCode.get(q);if(ex)preencher(ex);let res=produtos.filter(p=>String(p.codigo).includes(q)||p.descricao.toLowerCase().includes(q)||p.fornecedor.toLowerCase().includes(q)).slice(0,30);box.innerHTML=res.map(p=>`<div onclick="selecionar('${p.codigo}')"><b>${p.codigo}</b> - ${p.descricao}<br><small>${p.fornecedor} | Venda: ${brl.format(p.valorVenda)} | Custo: ${brl.format(p.custo)}</small></div>`).join('');box.style.display=res.length?'block':'none'}function buscarExato(){let q=String($('codigo').value||'').trim();let p=byCode.get(q.replace(/[^0-9]/g,''))||byCode.get(q);if(p){preencher(p);$('suggestBox').style.display='none';return true}alert('Código não encontrado na base carregada: '+q);return false}function selecionar(c){let p=byCode.get(String(c));if(p)preencher(p);$('suggestBox').style.display='none';$('qtdTotal').focus()}function preencher(p){$('codigo').value=p.codigo;$('descricao').value=p.descricao;$('fornecedor').value=p.fornecedor;$('valorVenda').value=Number(p.valorVenda||0).toFixed(2);$('custo').value=Number(p.custo||0).toFixed(2);calcular()}
function desc(){return $('estado').value==='A'?.30:$('estado').value==='B'?.50:.75}function setMoney(id,v){$(id).value=Number(v||0).toFixed(2)}function destinosAuto(){let ds=[];if(Number($('qtdLote').value||0)>0)ds.push('LOTE DE AVARIA');if(Number($('qtdRecup').value||0)>0)ds.push('RECUPERADO');if(Number($('qtdLixo').value||0)>0)ds.push('BAIXA POR PERDA');[...document.querySelectorAll('input[name="destinoManual"]:checked')].forEach(c=>{if(!ds.includes(c.value))ds.push(c.value)});return ds}function atualizaDestinoAuto(){let ds=destinosAuto();document.querySelectorAll('input[name="destinoManual"]').forEach(c=>{if(!manuais.includes(c.value))c.checked=ds.includes(c.value);c.parentElement.classList.toggle('active',ds.includes(c.value))});$('cardSel').textContent=ds.length?'Cards carregados: '+ds.join(' + '):'Digite QTD LOTE/QTD RECUP/QTD LIXO ou selecione um card manual.'}function calcular(){let venda=Number($('valorVenda').value||0),custo=Number($('custo').value||0),ql=Number($('qtdLote').value||0),qr=Number($('qtdRecup').value||0),qx=Number($('qtdLixo').value||0),d=desc(),preco=venda*(1-d),lote=custo*ql,rec=custo*qr,lixo=custo*qx,total=lote+rec+lixo;$('desconto').value=Math.round(d*100)+'%';setMoney('precoAvaria',preco);setMoney('valorTotal',total);setMoney('vlrLote',lote);setMoney('vlrRecup',rec);setMoney('vlrLixo',lixo);setMoney('vlrPerda',custo);atualizaDestinoAuto()}
function validarSalvar(ds){let qt=Number($('qtdTotal').value||0),ql=Number($('qtdLote').value||0),qr=Number($('qtdRecup').value||0),qx=Number($('qtdLixo').value||0),soma=ql+qr+qx;if(!ds.length){alert('Informe QTD LOTE, QTD RECUP, QTD LIXO ou selecione um card manual.');return false}if((ql>0||qr>0||qx>0)&&qt<=0){alert('Preencha QTD TOTAL para validar as quantidades.');$('qtdTotal').focus();return false}if(soma>qt){alert('A soma de QTD LOTE VENDA + QTD RECUPERADO + QTD LIXO não pode ser maior que a QTD TOTAL.');$('qtdTotal').focus();return false}if(ds.some(d=>manuais.includes(d))&&qt<=0){alert('Para os cards manuais, preencha QTD TOTAL.');$('qtdTotal').focus();return false}montarEndereco();if(!enderecoCompletoValido()){alert('Preencha o ENDEREÇO completo com 4 casas. Ex.: 101-25-10-301');$('endereco1').focus();return false}if(!$('palete').value.trim()){alert('Preencha o PALETE.');$('palete').focus();return false}if(!$('turno').value.trim()){alert('Preencha o TURNO.');$('turno').focus();return false}if(ds.includes('LOTE DE AVARIA')&&!$('motAvaria').value.trim()){alert('Para LOTE DE AVARIA, preencha o MOT.AVARIA.');$('motAvaria').focus();return false}if(ds.includes('BAIXA POR PERDA')&&!$('motPerda').value.trim()){alert('Para BAIXA POR PERDA, preencha o MOTIVO DA PERDA.');$('motPerda').focus();return false}if(ds.includes('TROCA CLIENTE')&&!$('motTroca').value.trim()){alert('Para TROCA CLIENTE, preencha o MOT. TROCA.');$('motTroca').focus();return false}if(ds.includes('DEV.FORNC')&&!$('motDevolucao').value.trim()){alert('Para DEV.FORNC, preencha o MOT. DEVOLUÇÃO.');$('motDevolucao').focus();return false}if(ds.includes('VENCIDOS')&&!$('validade').value){alert('Para VENCIDOS, preencha a VALIDADE.');$('validade').focus();return false}return true}
function salvar(e){e.preventDefault();if(!buscarExato())return;calcular();let ds=destinosAuto();if(!validarSalvar(ds))return;montarEndereco();let base={codigo:$('codigo').value,descricao:$('descricao').value,fornecedor:$('fornecedor').value,valorVenda:Number($('valorVenda').value||0),custo:Number($('custo').value||0),qtdTotal:Number($('qtdTotal').value||0),qtdLoteVenda:Number($('qtdLote').value||0),qtdRecup:Number($('qtdRecup').value||0),qtdLixo:Number($('qtdLixo').value||0),estado:$('estado').value,desconto:desc(),endereco:$('endereco').value,data:$('data').value||todayISO(),palete:$('palete').value,turno:$('turno').value,motAvaria:$('motAvaria').value,motPerda:$('motPerda').value,validade:$('validade').value,motDevolucao:$('motDevolucao').value,motTroca:$('motTroca').value,observacao:$('observacao').value};let lista=ds.map(destino=>{let b={...base,destino};if(destino==='RECUPERADO')b.endereco='PICKING';return recalcularLancamento(b)});$('statusBase').textContent='Salvando lançamentos no Google Sheets...';callGS({action:'salvarLancamentos',payload:JSON.stringify(lista)},r=>{if(r&&r.ok){limparForm(false);carregarTudo()}else alert('Erro ao salvar: '+(r&&r.erro||'sem resposta'))})}function excluir(id){if(!confirm('Excluir lançamento?'))return;callGS({action:'excluirLancamento',id:id},r=>{if(r&&r.ok)carregarTudo();else alert('Erro ao excluir: '+(r&&r.erro||'sem resposta'))})}function limparCardAdmin(){let card=cardRelatorio();if(card==='CARD ATUAL')card=[...selecionados][0];if(!confirm('ATENÇÃO: serão apagados definitivamente os lançamentos do card '+card+' na base Google Sheets. Deseja continuar?'))return;let conf=prompt('Para confirmar, digite LIMPAR');if(conf!=='LIMPAR'){alert('Confirmação cancelada.');return}let senha=prompt('Digite a senha de administrador');if(!senha){alert('Senha não informada.');return}$('statusBase').textContent='Limpando lançamentos do card '+card+'...';callGS({action:'limparCard',card:card,confirmacao:'LIMPAR',senha:senha},r=>{if(r&&r.ok){alert('Limpeza concluída. Card: '+card+' | Linhas removidas: '+(r.removidos||0));carregarTudo()}else alert('Erro ao limpar card: '+(r&&r.erro||'sem resposta'))})}

function excluirPaleteAdmin(){
  let cardAtual=[...selecionados][0]||'LOTE DE AVARIA';
  let entrada=prompt('Digite um ou mais PALETES para excluir.\n\nPode separar por vírgula, ponto e vírgula, espaço ou uma linha por palete.\n\nExemplo: 10, 12, 15', '');
  if(!entrada||!String(entrada).trim()){alert('Nenhum palete informado.');return}
  let paletes=[...new Set(String(entrada).split(/[\n,;\t ]+/).map(p=>p.trim()).filter(Boolean))];
  if(!paletes.length){alert('Nenhum palete válido informado.');return}
  let card=prompt('Informe o CARD para excluir estes paletes.\n\nSugestão para venda em lote: LOTE DE AVARIA\n\nSe deixar vazio, será usado o card atual: '+cardAtual, cardAtual);
  if(card===null){alert('Exclusão cancelada.');return}
  card=String(card||cardAtual).trim();
  let setPaletes=new Set(paletes);
  let encontrados=lancamentos.filter(x=>setPaletes.has(String(x.palete||'').trim()) && (!card||String(x.destino||'').trim()===card));
  if(!encontrados.length){alert('Nenhum lançamento encontrado para os paletes informados'+(card?' no card '+card:''));return}
  let porPalete={};
  encontrados.forEach(x=>{let p=String(x.palete||'').trim();porPalete[p]=(porPalete[p]||0)+1});
  let naoEncontrados=paletes.filter(p=>!porPalete[p]);
  let resumo=paletes.map(p=>'- '+p+': '+(porPalete[p]||0)+' lançamento(s)').join('\n');
  let amostra=encontrados.slice(0,8).map(x=>'- Palete '+(x.palete||'')+' | '+(x.codigo||'')+' | '+(x.descricao||'')+' | '+(x.destino||'')+' | '+(x.data?fmtDate(x.data):'')).join('\n');
  if(encontrados.length>8)amostra+='\n... e mais '+(encontrados.length-8)+' lançamento(s).';
  let msg='ATENÇÃO!\n\nSerão excluídos '+encontrados.length+' lançamento(s).\nCard: '+(card||'Todos')+'\n\nResumo por palete:\n'+resumo;
  if(naoEncontrados.length)msg+='\n\nSem lançamentos encontrados:\n- '+naoEncontrados.join('\n- ');
  msg+='\n\nAmostra dos registros:\n'+amostra+'\n\nPara confirmar, digite EXCLUIR';
  let conf=prompt(msg);
  if(conf!=='EXCLUIR'){alert('Confirmação cancelada.');return}
  let senha=prompt('Digite a senha de administrador:');
  if(senha!=='condor@2526'){alert('Senha de administrador inválida.');return}
  if(!confirm('Confirma excluir '+encontrados.length+' lançamento(s) dos paletes informados?'))return;
  let ids=encontrados.map(x=>x.id).filter(Boolean),removidos=0,erros=[];
  $('statusBase').textContent='Excluindo lançamentos por palete... 0/'+ids.length;
  function proximo(i){
    if(i>=ids.length){
      alert('Exclusão por palete concluída.\n\nPaletes informados: '+paletes.join(', ')+'\nCard: '+(card||'Todos')+'\nRemovidos: '+removidos+'\nErros: '+erros.length);
      carregarTudo();
      return;
    }
    $('statusBase').textContent='Excluindo lançamentos por palete... '+(i+1)+'/'+ids.length;
    callGS({action:'excluirLancamento',id:ids[i]},r=>{
      if(r&&r.ok)removidos++;else erros.push(ids[i]+': '+((r&&r.erro)||'sem resposta'));
      proximo(i+1);
    });
  }
  proximo(0);

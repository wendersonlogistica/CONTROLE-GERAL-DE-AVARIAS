<!-- ============================================================
   V211 CORRECAO - ESTABILIZACAO DOS CARDS DEMERITO / VALORES DIARIOS
   Base mantida: V211.
   Objetivo:
   - Eliminar oscilacao visual ao alternar DEMERITO e VALORES DIARIOS.
   - Nao alterar cards operacionais, filtros de coluna, orcamento, periodo ou calculos.
   - Evitar que rotinas visuais antigas reapliquem layout de tabela principal nos cards especiais.
   ============================================================ -->
<script>
(function(){
  if(window.__v211EstabilizaCardsEspeciais) return;
  window.__v211EstabilizaCardsEspeciais = true;

  var DEM = 'DEMÉRITO';
  var VAL = 'VALORES DIÁRIOS';
  var classesOperacionais = [
    'v209-card-lote','v209-card-recuperado','v209-card-baixa','v209-card-vencidos',
    'v209-card-dev','v209-card-troca','v209-card-deb','v209-card-especial'
  ];

  function $(id){ return document.getElementById(id); }
  function ativo(){
    try{
      return (typeof selecionados !== 'undefined' && selecionados && selecionados.size) ? Array.from(selecionados)[0] : 'LOTE DE AVARIA';
    }catch(e){ return 'LOTE DE AVARIA'; }
  }
  function setAtivo(card){
    try{ selecionados = new Set([card]); }
    catch(e){ window.selecionados = new Set([card]); }
  }
  function especial(card){ return card === DEM || card === VAL; }

  function ocultarFiltroColunaV211(){
    var painel = $('painelFiltroColunaV211');
    if(painel) painel.style.display = 'none';
    var status = $('statusFiltroColunaV211');
    if(status){ status.style.display = 'none'; status.textContent = ''; }
  }

  function estabilizarEspecial(card){
    if(!especial(card)) return;

    document.body.classList.add('v211EspecialEstavel');
    classesOperacionais.forEach(function(c){ document.body.classList.remove(c); });

    if(card === DEM){
      document.body.classList.add('modoDemeritoV121');
      document.body.classList.remove('modoValoresDiariosV122');
      if($('tableTitle')) $('tableTitle').textContent = 'DEMÉRITO POR AVARIA';
    }else{
      document.body.classList.remove('modoDemeritoV121');
      document.body.classList.add('modoValoresDiariosV122');
      if($('tableTitle')) $('tableTitle').textContent = 'VALORES DIÁRIOS';
    }

    var table = $('mainTable');
    if(table){
      table.setAttribute('data-card', card);
      table.setAttribute('data-card-v211-especial', card);
    }

    ocultarFiltroColunaV211();
  }

  function liberarEspecial(){
    document.body.classList.remove('v211EspecialEstavel');
  }

  var toggleAnterior = window.toggleDestino;
  window.toggleDestino = function(card){
    if(especial(card)){
      setAtivo(card);
      var r;
      if(typeof toggleAnterior === 'function'){
        r = toggleAnterior.apply(this, arguments);
      }
      estabilizarEspecial(card);
      setTimeout(function(){ estabilizarEspecial(card); }, 40);
      setTimeout(function(){ estabilizarEspecial(card); }, 160);
      return r;
    }
    liberarEspecial();
    return (typeof toggleAnterior === 'function') ? toggleAnterior.apply(this, arguments) : undefined;
  };
  try{ toggleDestino = window.toggleDestino; }catch(e){}

  var renderAnterior = window.render;
  window.render = function(){
    var card = ativo();
    var r = (typeof renderAnterior === 'function') ? renderAnterior.apply(this, arguments) : undefined;
    if(especial(card)){
      estabilizarEspecial(card);
      setTimeout(function(){ estabilizarEspecial(card); }, 60);
    }else{
      liberarEspecial();
    }
    return r;
  };
  try{ render = window.render; }catch(e){}

  document.addEventListener('DOMContentLoaded', function(){
    setTimeout(function(){ if(especial(ativo())) estabilizarEspecial(ativo()); }, 500);
    setTimeout(function(){ if(especial(ativo())) estabilizarEspecial(ativo()); }, 1500);
  });
})();
</script>

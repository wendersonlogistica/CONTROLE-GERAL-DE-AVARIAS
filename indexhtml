        +'<td class="center">'+escV161(x.qtdItens||0)+'</td>'
        +'<td class="num">'+moneyV161(x.total)+'</td>'
        +'<td class="center"><button type="button" onclick="verItensOrcamentoV161(\''+escV161(x.numero)+'\')">Ver itens</button></td>'
        +'</tr>';
    }).join('');
  }
  window.verItensOrcamentoV161=function(numero){
    var det=document.getElementById('detalheOrcV161');
    if(!det)return;
    var reg=(cacheOrcV161||[]).find(function(x){return String(x.numero)===String(numero);});

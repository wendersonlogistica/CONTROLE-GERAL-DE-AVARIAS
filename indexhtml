<!-- ============================================================
     V206 TESTE - CABECALHO NAO SOME + DESCRICAO SEM QUEBRA
     Base: V201 aprovada.
     Mantem da V205:
     - Sem oscilacao na troca dos cards normais.
     - LOTE DE AVARIA menor e fixo.
     - Coluna ACOES com botoes Editar/Excluir cabendo.
     Corrige:
     - Cabecalho real reaparece e permanece apos trocar card.
     - DESCRICAO em VENCIDOS sem quebra de linha, com reticencias.
     Nao altera Demerito, Valores Diarios, calculos, periodo, orcamento ou base.
     ============================================================ -->
<script>
(function(){
  if(window.__v206CabecalhoDescricaoInstalado) return;
  window.__v206CabecalhoDescricaoInstalado = true;

  var DEM = 'DEMÉRITO';
  var VAL = 'VALORES DIÁRIOS';
  var oldToggleV206 = window.toggleDestino;
  var oldRenderV206 = window.render;

  function $(id){return document.getElementById(id);}
  function qsa(sel){return Array.prototype.slice.call(document.querySelectorAll(sel));}
  function esc(s){return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]||c;});}
  function isEspecial(card){return card===DEM || card===VAL;}
  function activeCard(){try{return selecionados&&selecionados.size?Array.from(selecionados)[0]:'LOTE DE AVARIA';}catch(e){return 'LOTE DE AVARIA';}}
  function setActive(card){try{selecionados=new Set([card]);}catch(e){window.selecionados=new Set([card]);}}

  function headV206(card){
    var d=String(card||'').toUpperCase();
    if(d==='BAIXA POR PERDA')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','FORNECEDOR','MOTIVO DA PERDA','CUSTO REAL UNIT','QTDE.','VLR TOTAL','OBSERVAÇÃO','AÇÕES'];
    if(d==='RECUPERADO')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','FORNECEDOR','CUSTO REAL UNIT','QTD RECUP','VLR RECUPERADO','PALETE','ENDEREÇO','OBSERVAÇÃO','AÇÕES'];
    if(d==='VENCIDOS')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','VALIDADE','FORNECEDOR','CUSTO REAL UNIT','QTDE.','VLR TOTAL','PALETE','ENDEREÇO','OBSERVAÇÃO','AÇÕES'];
    if(d==='DEV.FORNC')return ['CÓDIGO','DATA AVARIA','DESCRIÇÃO','MOT. DEVOLUÇÃO','FORNECEDOR','CUSTO REAL UNIT','QTDE.','VLR TOTAL','PALETE','ENDEREÇO','OBSERVAÇÃO','AÇÕES'];

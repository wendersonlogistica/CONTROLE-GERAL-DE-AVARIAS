      +'<div class="listaConsultaOrcV161"><table><thead><tr><th>Número</th><th>Status</th><th>Data</th><th>Comprador</th><th>Card</th><th>Itens</th><th>Total</th><th>Ação</th></tr></thead><tbody id="tbodyConsultaOrcV161"></tbody></table></div>'
      +'<div class="detalheConsultaOrcV161"><div class="detalheHeadV161">Itens do orçamento</div><div id="detalheOrcV161" class="detalheOrcV161">Selecione um orçamento para ver os itens.</div></div>'
      +'</div>'
      +'</div></div>';
    document.body.appendChild(m);
    document.getElementById('fecharConsultaOrcV161').onclick=function(){m.style.display='none';};
    document.getElementById('btnAtualizarOrcV161').onclick=carregarOrcamentosV161;
    document.getElementById('filtroStatusOrcV161').onchange=renderOrcamentosV161;
    document.getElementById('filtroTextoOrcV161').oninput=renderOrcamentosV161;
    return m;
  }
  function abrirConsultaOrcamentosV161(){
    var m=garantirModalV161();
    m.style.display='flex';
    carregarOrcamentosV161();
  }
  function carregarOrcamentosV161(){
    var resumo=document.getElementById('resumoConsultaOrcV161');
    if(resumo)resumo.textContent='Carregando orçamentos...';
    var locais=localOrcsV161().map(function(x){return normalizarOrcV161(x,'Local');});
    if(typeof callGS==='function'){
      try{
        callGS({action:'listarOrcamentosPendentes'},function(r){
          var sheets=[];
          if(r&&r.ok&&Array.isArray(r.dados))sheets=r.dados.map(function(x){return normalizarOrcV161(x,'Sheets');});
          cacheOrcV161=mergeOrcsV161(sheets,locais).map(function(x){return normalizarOrcV161(x,x.__origem);});
          renderOrcamentosV161();
        });
      }catch(e){cacheOrcV161=locais;renderOrcamentosV161();}
    }else{
      cacheOrcV161=locais;renderOrcamentosV161();
    }
  }
  function filtrarOrcsV161(){
    var st=String((document.getElementById('filtroStatusOrcV161')||{}).value||'').toUpperCase();
    var txt=String((document.getElementById('filtroTextoOrcV161')||{}).value||'').toLowerCase().trim();
    return (cacheOrcV161||[]).filter(function(x){
      var ok=true;
      if(st)ok=ok&&String(x.status||'').toUpperCase()===st;
      if(txt){
        var base=[x.numero,x.cliente,x.documento,x.card,x.status].join(' ').toLowerCase();
        ok=ok&&base.indexOf(txt)>=0;
      }
      return ok;
    });
  }
  function renderOrcamentosV161(){
    var tb=document.getElementById('tbodyConsultaOrcV161');
    var resumo=document.getElementById('resumoConsultaOrcV161');
    if(!tb)return;
    var arr=filtrarOrcsV161();

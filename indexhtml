function valorCardV100(x,card){
  if(card==='LOTE DE AVARIA'){
    let q=Number(x.qtdLoteVenda||0);
    let unit=Number(x.precoAvaria||0)||Number(x.valorVenda||0)*(1-Number(x.desconto||0));
    return {qtd:q,total:unit*q};
  }
  if(card==='VENCIDOS'){
    let q=Number(x.qtdTotal||0);
    return {qtd:q,total:Number(x.custo||0)*q};
  }
  if(card==='RECUPERADO') return {qtd:Number(x.qtdRecup||0),total:Number(x.vlrRecuperado||0)};
  if(card==='BAIXA POR PERDA') return {qtd:Number(x.qtdLixo||0),total:Number(x.vlrLixo||0)};
  let q=Number(x.qtdTotal||0);
  let total=Number(x.valorTotal||0);
  if(!total) total=Number(x.custo||0)*q;
  return {qtd:q,total:total};
}
function resumoCardV100(card){
  let arr=(typeof lancamentos!=='undefined'?lancamentos:[]).filter(x=>x.destino===card);
  let total=0,qtd=0;
  arr.forEach(x=>{let r=valorCardV100(x,card);total+=Number(r.total||0);qtd+=Number(r.qtd||0);});
  return {itens:arr.length,qtd:qtd,total:total};
}
